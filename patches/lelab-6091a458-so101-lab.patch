+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { afterEach, expect, test, vi } from "vitest";
+import { ApiProvider } from "./ApiProvider";
+import { useApi } from "./ApiContext";
+import { HfAuthProvider } from "./HfAuthProvider";
+import { useHfAuth } from "./HfAuthContext";
+import { UrdfProvider } from "./UrdfProvider";
+import { useUrdf } from "@/hooks/useUrdf";
+
+Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+afterEach(() => { vi.unstubAllGlobals(); localStorage.clear(); });
+
+test("split providers and consumer hooks share identity, config and read-only state", async () => {
+  localStorage.setItem("lelab.apiBaseUrl", "http://127.0.0.1:8000");
+  const fetcher = vi.fn(async (url: string, options?: RequestInit) => {
+    expect(options?.method ?? "GET").toBe("GET");
+    if (url.endsWith("/hf-auth-status")) return new Response(JSON.stringify({ authenticated: false }));
+    if (url === "/so-101-urdf/urdf/so101_new_calib.urdf") return new Response("<robot name='synthetic' />");
+    throw new Error(`Unexpected fixture request: ${url}`);
+  });
+  vi.stubGlobal("fetch", fetcher);
+  function Consumer() {
+    const api = useApi();
+    const { auth } = useHfAuth();
+    const { urdfContent } = useUrdf();
+    return <output>{JSON.stringify({ base: api.baseUrl, ws: api.wsBaseUrl, auth: auth.status, urdfContent })}</output>;
+  }
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    await act(async () => root.render(
+      <ApiProvider><HfAuthProvider><UrdfProvider><Consumer /></UrdfProvider></HfAuthProvider></ApiProvider>,
+    ));
+    expect(JSON.parse(host.textContent!)).toEqual({
+      base: "http://127.0.0.1:8000", ws: "ws://127.0.0.1:8000", auth: "unauthenticated",
+      urdfContent: "<robot name='synthetic' />",
+    });
+    expect(fetcher).toHaveBeenCalledTimes(2);
+  } finally {
+    await act(async () => root.unmount());
+  }
+});
