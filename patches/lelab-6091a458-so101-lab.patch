+import React from "react";
+import type { ColorSortingSummary as Summary } from "@/lib/datasetApi";
+import { COLOR_SORTING_PRESET } from "@/lib/colorSorting";
+
+const SummaryStat: React.FC<{ label: string; value: number }> = ({ label, value }) => (
+  <span className="flex items-baseline gap-1.5">
+    <span className="text-[10px] uppercase tracking-wider text-blue-300/60">{label}</span>
+    <span className="font-medium tabular-nums text-blue-50">{value}</span>
+  </span>
+);
+
+const ColorSortingSummary: React.FC<{
+  selected: boolean;
+  summary?: Summary | null;
+}> = ({ selected, summary }) => {
+  if (!selected && !summary) return null;
+  return (
+    <div className="mb-4 rounded-lg border border-blue-900/70 bg-blue-950/20 p-4 text-xs text-blue-100">
+      <div className="flex flex-wrap items-center justify-between gap-2">
+        <p className="text-sm font-medium">Three-color sorting · {summary?.stage ?? "C1 pilot"}</p>
+        <span className="font-mono text-blue-200/80">
+          ACT chunk {summary?.policy.chunk_size ?? COLOR_SORTING_PRESET.policy.chunkSize}
+          {" · "}execute {summary?.policy.n_action_steps ?? COLOR_SORTING_PRESET.policy.nActionSteps}
+        </span>
+      </div>
+      <p className="mt-1 text-blue-200/70">
+        Task text and visual labels are audit metadata; they are not ACT language or target inputs.
+      </p>
+      {summary ? (
+        <div className="mt-3 flex flex-wrap gap-x-5 gap-y-1">
+          <SummaryStat label="Started" value={summary.evaluation.attempts_started} />
+          <SummaryStat label="Correct" value={summary.evaluation.correct_placements} />
+          <SummaryStat label="Failure" value={summary.evaluation.human_outcomes.failure} />
+          <SummaryStat label="Abort" value={summary.evaluation.human_outcomes.abort} />
+          <SummaryStat label="Unknown" value={summary.evaluation.human_outcomes.unknown} />
+          <SummaryStat label="Preflight rejected" value={summary.evaluation.preflight_rejected} />
+        </div>
+      ) : (
+        <p className="mt-3 text-amber-200">
+          No human-verified local result summary exists yet. Episode presence alone does not establish task success.
+        </p>
+      )}
+    </div>
+  );
+};
+
+export default ColorSortingSummary;
