+def test_reload_clears_unresolved_stop_fence_without_inventing_success(tmp_path) -> None:
+    from lelab.jobs import JobRegistry
+
+    root = tmp_path / "jobs"
+    record = _running_record(tmp_path, stop_in_progress=True)
+    record.process_identity = None
+    path = root / record.id / "job.json"
+    path.parent.mkdir(parents=True)
+    path.write_text(record.model_dump_json(), encoding="utf-8")
+
+    registry = JobRegistry(root)
+    try:
+        loaded = registry.get(record.id)
+        assert loaded.stop_in_progress is False
+        assert loaded.stopped_by_user is False
+        assert loaded.state == "interrupted"
+    finally:
+        registry.shutdown()
