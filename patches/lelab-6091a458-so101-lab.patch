@@ -0,0 +1,82 @@
+// @vitest-environment jsdom
+import React, { act } from "react";
+import { createRoot, type Root } from "react-dom/client";
+import { afterEach, beforeEach, expect, test, vi } from "vitest";
+import type { Fetcher } from "@/lib/apiClient";
+import { useOnboardingProgress } from "./useOnboardingProgress";
+
+const { fetcher } = vi.hoisted(() => ({ fetcher: vi.fn<Fetcher>() }));
+vi.mock("@/contexts/ApiContext", () => ({
+  useApi: () => ({ baseUrl: "http://localhost:8000", fetchWithHeaders: fetcher }),
+}));
+vi.mock("@/contexts/HfAuthContext", () => ({
+  useHfAuth: () => ({ auth: { status: "unauthenticated" } }),
+}));
+
+let root: Root;
+let current: ReturnType<typeof useOnboardingProgress>;
+function Probe({ active }: { active: boolean }) {
+  current = useOnboardingProgress(active);
+  return null;
+}
+
+beforeEach(() => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  vi.useFakeTimers();
+  vi.stubGlobal("fetch", vi.fn(() => { throw new Error("No real requests in this fixture"); }));
+  fetcher.mockReset();
+  localStorage.clear();
+  root = createRoot(document.createElement("div"));
+});
+afterEach(() => {
+  act(() => root.unmount());
+  localStorage.clear();
+  vi.useRealTimers();
+  vi.unstubAllGlobals();
+});
+
+test("a closed tour does not poll or request hardware", async () => {
+  await act(async () => root.render(<Probe active={false} />));
+  await act(async () => vi.advanceTimersByTimeAsync(6000));
+  expect(fetcher).not.toHaveBeenCalled();
+  expect(Object.values(current)).toEqual([false, false, false, false, false]);
+});
+
+test.each(["local", "both", "hub"])("reads %s dataset progress using only local GET endpoints", async (source) => {
+  localStorage.setItem("lelab.selectedRobot", "Fixture");
+  fetcher.mockImplementation(async (url, options) => {
+    expect(options?.method ?? "GET").toBe("GET");
+    const route = new URL(url).pathname + new URL(url).search;
+    const payloads: Record<string, unknown> = {
+      "/robots": { robots: [{ name: "Fixture", is_clean: true }] },
+      "/datasets?scope=local": [{ repo_id: "fixture/demo", source, last_modified: null, private: true }],
+      "/jobs?limit=20": { jobs: [{ state: "running", checkpoint_count: 1 }] },
+    };
+    if (!(route in payloads)) throw new Error(`Unexpected endpoint: ${route}`);
+    return new Response(JSON.stringify(payloads[route]));
+  });
+  await act(async () => root.render(<Probe active />));
+  expect(current).toEqual({
+    hasSelectedRobot: true, robotIsClean: true,
+    hasLocalDataset: source !== "hub", hasTrainedModel: true, isAuthenticated: false,
+  });
+  expect(fetcher).toHaveBeenCalledTimes(3);
+  await act(async () => root.render(<Probe active={false} />));
+  await act(async () => vi.advanceTimersByTimeAsync(6000));
+  expect(fetcher).toHaveBeenCalledTimes(3);
+  expect(Object.values(current)).toEqual([false, false, false, false, false]);
+});
+
+test("unavailable endpoints leave progress empty and polling can recover", async () => {
+  fetcher.mockRejectedValue(new Error("synthetic unavailable endpoint"));
+  await act(async () => root.render(<Probe active />));
+  expect(Object.values(current)).toEqual([false, false, false, false, false]);
+  expect(fetcher).toHaveBeenCalledTimes(3);
+  fetcher.mockImplementation(async (url) => new Response(JSON.stringify(
+    url.includes("/jobs?") ? { jobs: [{ state: "done", checkpoint_count: 0 }] }
+      : url.endsWith("/robots") ? { robots: [] } : [],
+  )));
+  await act(async () => vi.advanceTimersByTimeAsync(3000));
+  expect(current.hasTrainedModel).toBe(true);
+  expect(current.hasLocalDataset).toBe(false);
+});
