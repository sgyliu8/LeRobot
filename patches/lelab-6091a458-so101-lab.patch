+        type: "opencv",
+        camera_index: 1,
+        width: 640,
+        height: 480,
+        fps: 30,
+      },
+    ];
+    const issues = validateRecordingInputs(
+      15.5,
+      23.5,
+      {
+        shoulder_pan: 5,
+        shoulder_lift: 5,
+        elbow_flex: 5,
+        wrist_flex: 5,
+        wrist_roll: 5,
+        gripper: 5,
