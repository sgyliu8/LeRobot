@@ -0,0 +1,91 @@
+import React from 'react';
+import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
+import { Label } from '@/components/ui/label';
+import { NumberInput } from '@/components/ui/number-input';
+import { Button } from '@/components/ui/button';
+import { COLOR_SORTING_PRESET } from '@/lib/colorSorting';
+import { ConfigComponentProps } from '../types';
+
+const ActCard: React.FC<ConfigComponentProps> = ({ config, updateConfig }) => {
+  if (config.policy_type !== 'act') return null;
+
+  return (
+    <Card className="bg-slate-800/50 border-slate-700 rounded-xl">
+      <CardHeader>
+        <CardTitle className="text-white">ACT action chunks</CardTitle>
+      </CardHeader>
+      <CardContent className="space-y-4">
+        <p className="text-xs text-slate-400">
+          ACT reads camera images and robot state. The task description labels the dataset; it is not a
+          language command consumed by this policy.
+        </p>
+        <Button
+          type="button"
+          variant="outline"
+          size="sm"
+          onClick={() => {
+            updateConfig('policy_chunk_size', COLOR_SORTING_PRESET.policy.chunkSize);
+            updateConfig('policy_n_action_steps', COLOR_SORTING_PRESET.policy.nActionSteps);
+            updateConfig('dataset_image_transforms_enable', false);
+            updateConfig('dataset_task', 'color_sorting_v1');
+            updateConfig('steps', 100);
+            updateConfig('batch_size', 2);
+            updateConfig('num_workers', 0);
+            updateConfig('save_freq', 100);
+            updateConfig('eval_steps', 100);
+          }}
+          className="border-blue-800 bg-blue-950/30 text-blue-100 hover:bg-blue-900/50"
+        >
+          Use color sorting candidate (32 / 8)
+        </Button>
+        {config.dataset_task && (
+          <div className="text-xs text-blue-200 space-y-2" role="status">
+            <p>Frozen color-sorting split required. Only admitted train episodes and their statistics
+              are used. Validation is separate; test episodes are never loaded. Image augmentation is off.</p>
+            <Label htmlFor="act_eval_steps">Validation loss every N steps (0 disables)</Label>
+            <NumberInput id="act_eval_steps" min={0} value={config.eval_steps}
+              onChange={(value) => updateConfig('eval_steps', value)} />
+            <Button type="button" variant="ghost" size="sm"
+              onClick={() => updateConfig('dataset_task', undefined)}>
+              Clear task selection
+            </Button>
+          </div>
+        )}
+        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
+          <div>
+            <Label htmlFor="act_policy_chunk_size" className="text-slate-300">
+              Prediction chunk size
+            </Label>
+            <NumberInput
+              id="act_policy_chunk_size"
+              min={1}
+              value={config.policy_chunk_size}
+              onChange={(value) => updateConfig('policy_chunk_size', value)}
+              placeholder="100 (official default)"
+              className="bg-slate-900 border-slate-600 text-white rounded-lg"
+            />
+          </div>
+          <div>
+            <Label htmlFor="act_policy_n_action_steps" className="text-slate-300">
+              Execution prefix
+            </Label>
+            <NumberInput
+              id="act_policy_n_action_steps"
+              min={1}
+              value={config.policy_n_action_steps}
+              onChange={(value) => updateConfig('policy_n_action_steps', value)}
+              placeholder="100 (official default)"
+              className="bg-slate-900 border-slate-600 text-white rounded-lg"
+            />
+          </div>
+        </div>
+        <p className="text-xs text-slate-500">
+          Execution prefix must be no greater than prediction chunk size. Blank fields use the fixed
+          LeRobot ACT defaults. The 32 / 8 preset still requires offline latency and result validation.
+        </p>
+      </CardContent>
+    </Card>
+  );
+};
+
