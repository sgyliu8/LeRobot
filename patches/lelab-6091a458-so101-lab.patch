+def _validate_windows_checkpoint_path_budget(job_dir: Path) -> None:
+    """Fail before training when native checkpoint writers will exceed MAX_PATH."""
+    if os.name != "nt":
+        return
+    representative = (
+        job_dir
+        / "run"
+        / "checkpoints"
+        / "000000"
+        / "pretrained_model"
+        / "policy_preprocessor_step_99_normalizer_processor.safetensors"
+    )
+    # Safetensors' native Windows writer does not consistently honor the
+    # extended-path prefix. Leave headroom for longer processor step names.
+    if len(str(representative.resolve())) >= 240:
+        raise ValueError(
+            "Local training output path is too long for reliable Windows checkpoint saves; "
+            "choose a shorter LELAB_OUTPUT_ROOT"
+        )
+
+
+def _validate_windows_checkpoint_read_paths(checkpoint_dir: Path) -> None:
+    """Reject source files whose native readers may not honor extended paths."""
+    if os.name != "nt":
+        return
+    too_long = [path for path in checkpoint_dir.rglob("*") if path.is_file() and len(str(path)) >= 240]
+    if too_long:
+        raise ValueError(
+            "Source checkpoint path is too long for reliable Windows loading; "
+            "move or copy the job to a shorter local output root before resuming"
+        )
+
+
+def _read_utf8_or_legacy_windows_text(path: Path) -> str:
+    """Read current UTF-8 files and metadata written by old Windows builds."""
+    payload = path.read_bytes()
+    try:
+        return payload.decode("utf-8")
+    except UnicodeDecodeError:
+        # Older builds relied on the process locale when writing job files.
+        # ``mbcs`` resolves to the active Windows ANSI code page even when the
+        # current process was launched with Python UTF-8 mode.
+        return payload.decode("mbcs" if os.name == "nt" else "cp1252")
