@@ -0,0 +1,41 @@
+import path from "node:path";
+import { runInNewContext } from "node:vm";
+import { build } from "vite";
+import { expect, test, vi } from "vitest";
+
+test.each(["production", "development"])("%s build preserves warnings and argument side effects", async (mode) => {
+  const result = await build({
+    configFile: path.resolve("vite.config.ts"),
+    mode,
+    logLevel: "silent",
+    plugins: [{
+      name: "synthetic-console-fixture",
+      resolveId: (id) => id === "virtual:console-fixture" ? id : null,
+      load: (id) => id === "virtual:console-fixture" ? `
+        globalThis.fixtureEffects = 0;
+        function effect() { globalThis.fixtureEffects++; }
+        console.log("fixture-log", effect());
+        console.debug("fixture-debug", effect());
+        console.info("fixture-info", effect());
+        console.warn("fixture-warn");
+        console.error("fixture-error");
+      ` : null,
+    }],
+    build: {
+      write: false, emptyOutDir: false, minify: false,
+      rolldownOptions: { input: "virtual:console-fixture" },
+    },
+  });
+  if (!("output" in result)) throw new Error("Expected an in-memory build");
+  const chunk = result.output.find((entry) => entry.type === "chunk");
+  if (!chunk || chunk.type !== "chunk") throw new Error("Missing fixture chunk");
+  const console = { log: vi.fn(), debug: vi.fn(), info: vi.fn(), warn: vi.fn(), error: vi.fn() };
+  const scope = { console, fixtureEffects: 0 };
+  runInNewContext(chunk.code, scope);
+  expect(scope.fixtureEffects).toBe(3);
+  for (const method of ["log", "debug", "info"] as const) {
+    expect(console[method]).toHaveBeenCalledTimes(mode === "production" ? 0 : 1);
+  }
+  expect(console.warn).toHaveBeenCalledWith("fixture-warn");
+  expect(console.error).toHaveBeenCalledWith("fixture-error");
+});
