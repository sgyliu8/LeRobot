diff --git a/frontend/src/lib/frontendDependencies.test.ts b/frontend/src/lib/frontendDependencies.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e19ecb26f22c14b1e45867f0c1d6746bdb3d754c
--- /dev/null
+++ b/frontend/src/lib/frontendDependencies.test.ts
@@ -0,0 +1,42 @@
+// Dependency maintenance must preserve the existing controls, not just pass audit.
+import { readFileSync } from "node:fs";
+import path from "node:path";
+import postcss from "postcss";
+import tailwind from "@tailwindcss/postcss";
+import { describe, expect, it } from "vitest";
+import { cn } from "./utils";
+
+describe("locked frontend build", () => {
+  it("does not reintroduce the retired vulnerable build chain", () => {
+    const lock = JSON.parse(readFileSync("package-lock.json", "utf8"));
+    const packages = Object.keys(lock.packages);
+    for (const name of ["braces", "micromatch", "postcss-selector-parser", "lovable-tagger"]) {
+      expect(packages.filter((key) => key.endsWith(`/node_modules/${name}`) || key === `node_modules/${name}`)).toEqual([]);
+    }
+    expect(lock.packages["node_modules/source-map-js"].version).toBe("1.2.2");
+    expect(lock.packages["node_modules/tailwindcss"].version).toBe("4.3.3");
+  });
+
+  it("builds theme, focus, responsive, popover and animation styles", async () => {
+    const filename = path.resolve("src/index.css");
+    const css = readFileSync(filename, "utf8");
+    const result = await postcss([tailwind({ optimize: false })]).process(css, { from: filename });
+    const selectors = new Set<string>();
+    result.root.walkRules((rule) => { selectors.add(rule.selector); });
+    for (const selector of [
+      ".bg-background", ".border-input", ".shadow-xs", ".rounded-sm",
+      ".focus-visible\\:outline-hidden:focus-visible", ".md\\:text-sm", ".animate-in",
+      ".w-\\[var\\(--radix-popover-trigger-width\\)\\]",
+    ]) {
+      expect(selectors.has(selector), `missing ${selector}`).toBe(true);
+    }
+    expect(result.css).toContain("--tw-enter-opacity");
+    expect(result.css).not.toMatch(/@tailwind\s|@config\s|@source\s/);
+  });
+
+  it("keeps caller overrides when merging v4 classes", () => {
+    expect(cn("shadow-xs p-6", "shadow-lg pt-0")).toBe("p-6 shadow-lg pt-0");
+    expect(cn("w-[var(--radix-popover-trigger-width)]", "w-80")).toBe("w-80");
+    expect(cn("focus-visible:ring-2", "focus-visible:ring-4")).toBe("focus-visible:ring-4");
+  });
+});
