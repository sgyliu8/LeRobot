index 0000000000000000000000000000000000000000..46c2fc4d1b0f0be2f3f282f909f5a29c04365f2a
--- /dev/null
+++ b/lelab/mode.py
@@ -0,0 +1,109 @@
+"""Process-local ownership gate for hardware-affecting LeLab modes."""
+
+from __future__ import annotations
+
+import secrets
+import threading
+from dataclasses import dataclass
+from typing import Literal
+
+HardwareMode = Literal["calibration", "teleoperation", "recording", "inference"]
+GateMode = HardwareMode | Literal["shutdown"]
+GateOwner = GateMode | Literal["cleanup_fault"]
+
+
+@dataclass(frozen=True)
+class HardwareLease:
+    """Unforgeable ownership handle for one hardware-affecting session."""
+
+    mode: GateMode
+    token: str
+
+
+class HardwareModeGate:
+    """Atomically reserve the single local hardware owner slot.
+
+    Releasing by mode name is vulnerable to an ABA race: a delayed worker from
+    an old session can release a newer session of the same mode. Every claim
+    therefore receives a unique lease and only that exact lease may release it.
+    """
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._lease: HardwareLease | None = None
+        self._cleanup_fault: str | None = None
+
+    def _claim(self, mode: GateMode) -> tuple[HardwareLease | None, GateOwner | None]:
+        with self._lock:
+            if mode != "shutdown" and self._cleanup_fault is not None:
+                return None, "cleanup_fault"
+            if self._lease is not None:
+                return None, self._lease.mode
+            lease = HardwareLease(mode=mode, token=secrets.token_urlsafe(24))
+            self._lease = lease
+            return lease, None
+
+    def claim(self, mode: HardwareMode) -> tuple[HardwareLease | None, GateOwner | None]:
+        return self._claim(mode)
+
+    def claim_shutdown(self) -> tuple[HardwareLease | None, GateOwner | None]:
+        """Fence new hardware starts while the owned server is being stopped."""
+
+        return self._claim("shutdown")
+
+    def release(self, lease: HardwareLease) -> bool:
+        with self._lock:
+            if self._lease != lease:
+                return False
+            self._lease = None
+            return True
+
+    def release_shutdown(self, token: str) -> bool:
+        """Release a failed stop attempt without accepting a mode-only handle."""
+
+        with self._lock:
+            if self._lease is None or self._lease.mode != "shutdown" or self._lease.token != token:
+                return False
+            self._lease = None
+            return True
+
+    def matches(self, lease: HardwareLease | None) -> bool:
+        with self._lock:
+            return lease is not None and self._lease == lease
+
+    def mark_cleanup_fault(self, lease: HardwareLease, detail: str) -> bool:
+        """Release an exact session into a process-lifetime hardware fault latch.
+
+        New hardware work remains blocked until the local server is restarted;
+        the shutdown fence is still allowed so that restart is possible.
+        """
+
+        with self._lock:
+            if self._lease != lease:
+                return False
+            self._lease = None
+            self._cleanup_fault = detail
+            return True
+
+    def current(self) -> GateOwner | None:
+        with self._lock:
+            if self._lease:
+                return self._lease.mode
+            return "cleanup_fault" if self._cleanup_fault is not None else None
+
+    def cleanup_fault(self) -> str | None:
+        with self._lock:
+            return self._cleanup_fault
+
+    def current_session_id(self) -> str | None:
+        with self._lock:
+            return self._lease.token if self._lease else None
+
+    def reset_for_test(self) -> None:
+        """Reset only for a no-device test fixture."""
+        with self._lock:
+            self._lease = None
+            self._cleanup_fault = None
+
+
+hardware_mode_gate = HardwareModeGate()
