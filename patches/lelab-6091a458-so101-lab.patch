+// @vitest-environment jsdom
+import React, { act } from "react";
+import { createRoot } from "react-dom/client";
+import { expect, test, vi } from "vitest";
+import ConfigurationTab from "./ConfigurationTab";
+import { ComputeDeviceStatus, TrainingConfig } from "./types";
+
+vi.mock("./config/TargetCard", () => ({ default: () => null }));
+vi.mock("./config/EssentialsCard", () => ({ default: () => null }));
+vi.mock("./config/ActCard", () => ({ default: () => null }));
+vi.mock("./config/GrootCard", () => ({ default: () => null }));
+vi.mock("./config/AdvancedCard", () => ({ default: () => null }));
+
+const config: TrainingConfig = {
+  target: { runner: "local" },
+  dataset_repo_id: "local/demo",
+  dataset_video_backend: "pyav",
+  policy_type: "act",
+  steps: 10,
+  batch_size: 2,
+  num_workers: 0,
+  log_freq: 1,
+  save_freq: 10,
+  save_checkpoint: true,
+  resume: false,
+  wandb_enable: false,
+  wandb_disable_artifact: false,
+  policy_device: "auto",
+  policy_use_amp: false,
+  use_policy_training_preset: true,
+};
+
+const cpuStatus: ComputeDeviceStatus = {
+  gpu_present: false,
+  cuda_available: false,
+  mps_available: false,
+  xpu_available: false,
+  recommended_device: "cpu",
+  accelerator_available: false,
+  mismatch: false,
+  torch_version: "2.11.0+cpu",
+  install_hint: "Use the official selector",
+  docs_url: "https://pytorch.org/get-started/locally/",
+};
+
+test("shows the locally detected effective auto device", () => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    act(() => root.render(
+      <ConfigurationTab
+        config={config}
+        updateConfig={() => {}}
+        datasets={[]}
+        datasetsLoading={false}
+        authenticated={false}
+        flavors={[]}
+        hardwareLoading={false}
+        computeStatus={cpuStatus}
+      />,
+    ));
+    expect(host.textContent).toContain("Local training device");
+    expect(host.textContent).toContain("cpu");
+    expect(host.textContent).toContain("CUDA, MPS, XPU, then CPU");
+    expect(host.textContent).toContain("PyAV");
+    expect(host.textContent).toContain("before model startup");
+  } finally {
+    act(() => root.unmount());
+  }
+});
