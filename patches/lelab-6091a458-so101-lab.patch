+        stop_in_progress=stop_in_progress,
+    )
+
+
+class _BarrierStopRunner:
+    def __init__(self) -> None:
+        self.entered = threading.Event()
+        self.release = threading.Event()
+        self.stop_calls = 0
+
+    def stop(self):
+        self.stop_calls += 1
+        self.entered.set()
+        assert self.release.wait(timeout=2)
+        return "terminated"
+
+    def is_running(self):
+        return False
+
+    def returncode(self):
+        return None
+
+    def stream_log_lines(self):
+        return []
+
+    def wandb_run_url(self):
+        return None
+
+    def terminal_receipt(self):
+        return None
+
+
+def test_stop_fences_watchdog_and_deduplicates_concurrent_requests(tmp_path) -> None:
+    registry = _stopped_watchdog_registry(tmp_path)
+    record = _running_record(tmp_path)
+    runner = _BarrierStopRunner()
+    registry._records[record.id] = record
+    registry._runners[record.id] = runner
+    errors = []
+
+    def stop_once():
+        try:
+            registry.stop(record.id)
+        except Exception as exc:  # pragma: no cover - asserted below
+            errors.append(exc)
+
+    worker = threading.Thread(target=stop_once)
+    worker.start()
+    assert runner.entered.wait(timeout=2)
+    assert record.stop_in_progress is True
+
+    # Deterministically place the watchdog after process termination started
+    # but before the stop outcome was committed.
+    registry._tick()
+    assert record.state == "running"
+    assert record.id in registry._runners
+
+    # A second request must not terminate again or overwrite the first result.
+    assert registry.stop(record.id) is record
+    assert runner.stop_calls == 1
+    runner.release.set()
+    worker.join(timeout=3)
+    assert not worker.is_alive()
+    assert errors == []
+    assert record.stop_in_progress is False
+    assert record.stopped_by_user is True
+
+    registry._tick()
+    assert record.state == "interrupted"
+    assert record.error_message == "Stopped by operator"
+
+
+def test_stop_failure_clears_fence_without_claiming_operator_stop(tmp_path) -> None:
+    registry = _stopped_watchdog_registry(tmp_path)
+    record = _running_record(tmp_path)
+
+    class FailingRunner(_BarrierStopRunner):
+        def stop(self):
+            raise RuntimeError("termination not confirmed")
+
+        def is_running(self):
+            return True
+
+    runner = FailingRunner()
+    registry._records[record.id] = record
+    registry._runners[record.id] = runner
+    with pytest.raises(RuntimeError, match="termination not confirmed"):
+        registry.stop(record.id)
+    assert record.state == "running"
+    assert record.stop_in_progress is False
+    assert record.stopped_by_user is False
+    registry._tick()
+    assert record.state == "running"
+
+
+def test_reload_clears_unresolved_stop_fence_without_inventing_success(tmp_path) -> None:
+    from lelab.jobs import JobRegistry
+
+    root = tmp_path / "jobs"
+    record = _running_record(tmp_path, stop_in_progress=True)
+    record.process_identity = None
+    path = root / record.id / "job.json"
+    path.parent.mkdir(parents=True)
+    path.write_text(record.model_dump_json(), encoding="utf-8")
+
+    registry = JobRegistry(root)
+    try:
+        loaded = registry.get(record.id)
+        assert loaded.stop_in_progress is False
+        assert loaded.stopped_by_user is False
+        assert loaded.state == "interrupted"
+    finally:
+        registry.shutdown()
+
+
+def test_inference_checkpoint_resolution_rejects_escape(tmp_path, monkeypatch) -> None:
+    from lelab.jobs import JobCheckpoint
+
+    registry = _stopped_watchdog_registry(tmp_path)
+    record = _running_record(tmp_path)
