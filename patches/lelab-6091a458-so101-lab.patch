+def _canonicalize_repo_id(repo_id: str) -> str:
+    """Return a safe two-component local/Hub-style dataset identifier."""
+
+    raw = repo_id.strip()
+    if raw.count("/") > 1:
+        raise ValueError("dataset_repo_id must be '<namespace>/<name>' or a local name")
+    if "/" in raw:
+        namespace, name = raw.split("/", 1)
+    else:
+        namespace, name = "local", raw
+    namespace = re.sub(r"[^A-Za-z0-9._-]", "_", namespace)
+    name = re.sub(r"[^A-Za-z0-9._-]", "_", name)
+    if not namespace or not name or namespace in {".", ".."} or name in {".", ".."}:
+        raise ValueError("dataset_repo_id contains an empty or unsafe component")
+    return f"{namespace}/{name}"
+
+
+def _dataset_root(repo_id: str, *, must_exist: bool) -> Path:
+    if must_exist:
+        return resolve_dataset_dir(repo_id)
+    try:
+        return resolve_dataset_candidate(repo_id)
+    except DatasetNotFoundError as exc:
+        raise ValueError("dataset_repo_id escaped the local LeRobot cache") from exc
+
+
+def _recording_evidence_root() -> Path:
+    configured = os.environ.get("LELAB_RECORDING_EVIDENCE_ROOT")
+    root = Path(configured) if configured else Path.cwd() / ".local" / "evidence" / "recordings"
+    return root.expanduser().resolve()
+
+
+def _profile_path(repo_id: str) -> Path:
+    digest = hashlib.sha256(repo_id.encode("utf-8")).hexdigest()
+    return _recording_evidence_root() / "profiles" / f"{digest}.json"
+
