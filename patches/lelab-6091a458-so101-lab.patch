+// @vitest-environment jsdom
+import React, { act } from "react";
+import { createRoot } from "react-dom/client";
+import { expect, test, vi } from "vitest";
+import JobsSection from "./JobsSection";
+
+const mocks = vi.hoisted(() => ({
+  listJobs: vi.fn(), listHubJobs: vi.fn(), fetchWithHeaders: vi.fn(),
+}));
+vi.mock("@/contexts/ApiContext", () => ({ useApi: () => ({ baseUrl: "", fetchWithHeaders: mocks.fetchWithHeaders }) }));
+vi.mock("@/hooks/use-toast", () => ({ useToast: () => ({ toast: () => {} }) }));
+vi.mock("@/hooks/useRobots", () => ({ useRobots: () => ({ selectedRecord: null }) }));
+vi.mock("@/hooks/useJobsChangedSignal", () => ({ useJobsChangedSignal: () => {} }));
+vi.mock("@/lib/jobsApi", () => ({
+  listJobs: mocks.listJobs, listHubJobs: mocks.listHubJobs,
+  deleteJob: vi.fn(), resumeCheckpoint: vi.fn(), stopJob: vi.fn(),
+}));
+vi.mock("./JobCard", () => ({ default: ({ job }: { job: { name: string } }) => <div>{job.name}</div> }));
+vi.mock("./HubJobCard", () => ({ default: () => null }));
+vi.mock("./HubModelCard", () => ({ default: () => null }));
+vi.mock("./ImportModelModal", () => ({ default: () => null }));
+vi.mock("@/components/landing/InferenceModal", () => ({ default: () => null }));
+
+test.each(["pending", "rejected"])("local checkpoints render while Hub is %s", async (state) => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  mocks.listJobs.mockResolvedValue([{ id: "fixture", name: "Local checkpoint fixture", runner: "local", state: "done", checkpoint_count: 1 }]);
+  mocks.listHubJobs.mockImplementation(() => state === "pending"
+    ? new Promise(() => {}) : Promise.reject(new Error("fixture offline")));
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    await act(async () => { root.render(<JobsSection />); });
+    expect(host.textContent).toContain("Local checkpoint fixture");
+    expect(host.textContent).not.toContain("Couldn't load jobs");
+  } finally {
+    act(() => root.unmount());
+  }
+});
