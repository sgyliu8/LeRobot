+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { expect, test } from "vitest";
+import DataPreparationSummary from "./DataPreparationSummary";
+
+test("review status never implies source freshness or task success", () => {
+  const html = renderToStaticMarkup(<DataPreparationSummary summary={{
+    status: "FROZEN", episodes: 7, sessions: 3, pending: 0, excluded: 1,
+  }} />);
+  expect(html).toContain("Review and split frozen");
+  expect(html).toContain("rechecked at training start");
+  expect(html).toContain("does not mean task success");
+  expect(html).toContain("1");
+  expect(html).toContain("data_preparation_cli");
+  expect(html).not.toContain("<button"); // No motion, repair, deletion or training action.
+});
+
+test("failure and unreviewed states remain explicit", () => {
+  for (const status of ["NOT_REVIEWED", "AUDIT_FAILED", "INVALID_REVIEW", "REVIEW_REQUIRED"] as const) {
+    expect(renderToStaticMarkup(<DataPreparationSummary summary={{status}} />)).toContain("Raw videos and actions remain unchanged");
+  }
+  expect(renderToStaticMarkup(<DataPreparationSummary summary={undefined} />)).toBe("");
+});
