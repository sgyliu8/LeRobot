@@ -0,0 +1,41 @@
+import path from "node:path";
+import { runInNewContext } from "node:vm";
+import { build } from "vite";
+import { expect, test, vi } from "vitest";
+
+test.each(["production", "development"])("%s build preserves warnings and argument side effects", async (mode) => {
+  const result = await build({
+    configFile: path.resolve("vite.config.ts"),
+    mode,
+    logLevel: "silent",
+    plugins: [{
+      name: "synthetic-console-fixture",
+      resolveId: (id) => id === "virtual:console-fixture" ? id : null,
+      load: (id) => id === "virtual:console-fixture" ? `
+        globalThis.fixtureEffects = 0;
+        function effect() { globalThis.fixtureEffects++; }
+        console.log("fixture-log", effect());
+        console.debug("fixture-debug", effect());
+        console.info("fixture-info", effect());
+        console.warn("fixture-warn");
+        console.error("fixture-error");
+      ` : null,
+    }],
+    build: {
+      write: false, emptyOutDir: false, minify: false,
+      rolldownOptions: { input: "virtual:console-fixture" },
+    },
+  });
+  if (!("output" in result)) throw new Error("Expected an in-memory build");
+  const chunk = result.output.find((entry) => entry.type === "chunk");
+  if (!chunk || chunk.type !== "chunk") throw new Error("Missing fixture chunk");
+  const console = { log: vi.fn(), debug: vi.fn(), info: vi.fn(), warn: vi.fn(), error: vi.fn() };
+  const scope = { console, fixtureEffects: 0 };
+  runInNewContext(chunk.code, scope);
+  expect(scope.fixtureEffects).toBe(3);
+  for (const method of ["log", "debug", "info"] as const) {
+    expect(console[method]).toHaveBeenCalledTimes(mode === "production" ? 0 : 1);
+  }
+  expect(console.warn).toHaveBeenCalledWith("fixture-warn");
+  expect(console.error).toHaveBeenCalledWith("fixture-error");
+});
diff --git a/frontend/src/lib/bundleBoundaries.test.ts b/frontend/src/lib/bundleBoundaries.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e54332a192bc3431d368207efe4dfd80b80d86b4
--- /dev/null
+++ b/frontend/src/lib/bundleBoundaries.test.ts
@@ -0,0 +1,40 @@
+import path from "node:path";
+import { build, createLogger } from "vite";
+import { afterEach, expect, test, vi } from "vitest";
+
+afterEach(() => { vi.unstubAllEnvs(); vi.restoreAllMocks(); });
+
+test("real app defers route engines and stays within the unchanged chunk budget", async () => {
+  // Vitest sets NODE_ENV=test; measure the same React build shipped to users.
+  vi.stubEnv("NODE_ENV", "production");
+  const logger = createLogger("warn");
+  const warn = vi.spyOn(logger, "warn");
+  const result = await build({
+    configFile: path.resolve("vite.config.ts"),
+    mode: "production",
+    customLogger: logger,
+    build: { write: false, emptyOutDir: false },
+  });
+  if (!("output" in result)) throw new Error("Expected an in-memory app build");
+  const chunks = result.output.filter((item) => item.type === "chunk");
+  const entry = chunks.find((chunk) => chunk.isEntry);
+  if (!entry) throw new Error("Missing app entry");
+  const initial = new Set<string>();
+  const visit = (name: string) => {
+    if (initial.has(name)) return;
+    initial.add(name);
+    chunks.find((chunk) => chunk.fileName === name)?.imports.forEach(visit);
+  };
+  visit(entry.fileName);
+  const startup = chunks.filter((chunk) => initial.has(chunk.fileName));
+  expect(startup.reduce((sum, chunk) => sum + Buffer.byteLength(chunk.code), 0)).toBeLessThan(550_000);
+  for (const chunk of chunks) expect(Buffer.byteLength(chunk.code), chunk.fileName).toBeLessThan(500_000);
+  const modules = startup.flatMap((chunk) => Object.keys(chunk.modules)).join("\n");
+  expect(modules).not.toMatch(/node_modules[/\\](three|recharts)[/\\]/);
+  for (const page of ["Teleoperation", "Calibration", "Recording", "Training", "Inference", "EditDataset", "Upload"]) {
+    const chunk = chunks.find((item) => item.facadeModuleId?.endsWith(`/pages/${page}.tsx`));
+    expect(chunk?.isDynamicEntry, page).toBe(true);
+    expect(initial.has(chunk!.fileName), page).toBe(false);
+  }
+  expect(warn.mock.calls.flat().join("\n")).not.toMatch(/chunks are larger/);
+}, 60_000);
