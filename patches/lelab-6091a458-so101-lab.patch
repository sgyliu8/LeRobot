+def _read_utf8_or_legacy_windows_text(path: Path) -> str:
+    """Read current UTF-8 files and metadata written by old Windows builds."""
+    payload = path.read_bytes()
+    try:
+        return payload.decode("utf-8")
+    except UnicodeDecodeError:
+        # Older builds relied on the process locale when writing job files.
+        # ``mbcs`` resolves to the active Windows ANSI code page even when the
+        # current process was launched with Python UTF-8 mode.
+        return payload.decode("mbcs" if os.name == "nt" else "cp1252")
