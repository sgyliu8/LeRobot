--- /dev/null
+++ b/tests/test_server_lifespan.py
@@ -0,0 +1,62 @@
+"""Lifespan regression; conftest isolates job/evidence roots before import."""
+
+from unittest.mock import Mock
+
+import pytest
+
+
+@pytest.fixture
+def server(monkeypatch):
+    import cv2
+    import serial
+    import lerobot.robots
+    import lerobot.teleoperators
+
+    def forbidden(*args, **kwargs):
+        pytest.fail("Lifespan must not construct devices or launch a job")
+
+    monkeypatch.setattr(serial, "Serial", forbidden)
+    monkeypatch.setattr(cv2, "VideoCapture", forbidden)
+    monkeypatch.setattr(lerobot.robots, "make_robot_from_config", forbidden)
+    monkeypatch.setattr(lerobot.teleoperators, "make_teleoperator_from_config", forbidden)
+    from lelab import jobs
+    monkeypatch.setattr(jobs.LocalJobRunner, "start", forbidden)
+    from lelab import server
+    monkeypatch.setattr(server, "manager", server.ConnectionManager())
+    monkeypatch.setattr(server, "warn_if_cuda_mismatch", Mock())
+    return server
+
+
+def test_no_deprecated_event_registration(server):
+    assert server.app.router.on_startup == []
+    assert server.app.router.on_shutdown == []
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("raises", [False, True])
+async def test_lifespan_diagnostics_and_cleanup_once(server, monkeypatch, raises):
+    stop = Mock(wraps=server.manager.stop_broadcast_thread)
+    monkeypatch.setattr(server.manager, "stop_broadcast_thread", stop)
+    try:
+        async with server.app.router.lifespan_context(server.app):
+            server.warn_if_cuda_mismatch.assert_called_once_with()
+            stop.assert_not_called()
+            server.manager.start_broadcast_thread()
+            if raises:
+                raise RuntimeError("synthetic serving failure")
+    except RuntimeError as error:
+        assert raises and str(error) == "synthetic serving failure"
+    stop.assert_called_once_with()
+    assert not server.manager.is_running
+    assert server.manager._event_loop is None
+
+
+@pytest.mark.asyncio
+async def test_failed_startup_still_cleans_up(server, monkeypatch):
+    server.warn_if_cuda_mismatch.side_effect = RuntimeError("synthetic startup failure")
+    stop = Mock(wraps=server.manager.stop_broadcast_thread)
+    monkeypatch.setattr(server.manager, "stop_broadcast_thread", stop)
+    with pytest.raises(RuntimeError, match="synthetic startup failure"):
+        async with server.app.router.lifespan_context(server.app):
+            pytest.fail("Failed startup must not start serving")
+    stop.assert_called_once_with()
