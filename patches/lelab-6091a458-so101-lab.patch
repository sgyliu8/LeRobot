+import type { EpisodeListResponse } from "@/lib/datasetApi";
+
+const labels = {
+  NOT_REVIEWED: "Not reviewed · 尚未审核",
+  AUDIT_FAILED: "Technical audit failed · 完整性检查未通过",
+  REVIEW_REQUIRED: "Human review / session split required · 待人工审核与场次分区",
+  FROZEN: "Review and split frozen · 审核与分区已冻结",
+  INVALID_REVIEW: "Invalid review · 审核文件需要检查",
+};
+
+export default function DataPreparationSummary({ summary }: {
+  summary: EpisodeListResponse["data_preparation"];
+}) {
+  if (!summary) return null;
+  return (
+    <section className="mb-4 rounded-lg border border-gray-800 bg-gray-950 px-4 py-3 text-xs text-gray-300" aria-label="Data preparation">
+      <h2 className="font-medium text-gray-100">Training data review · 训练前数据审核</h2>
+      <p className="mt-1">{labels[summary.status]}</p>
+      {summary.episodes !== undefined && (
+        <p className="mt-1">{summary.episodes} episodes · {summary.sessions} sessions · {summary.pending} pending · {summary.excluded} marked exclude</p>
+      )}
+      <p className="mt-2 text-gray-400">Raw videos and actions remain unchanged. Use the local review tool to inspect, label and freeze session splits. Source bytes are rechecked at training start; frozen does not mean task success.</p>
+      <p className="mt-1 text-gray-400">原始视频和动作不删除、不剪切。按场次分区需要独立采集场次；同一场次不能拆成训练和测试。</p>
+      <p className="mt-2 break-words"><code>.venv\Scripts\python.exe -m so101_lab.data_preparation_cli --help</code></p>
+      <p className="mt-1">Local guide · 本地指南：<code>docs/DATA_PREPARATION.md</code> · Launcher menu 8</p>
+    </section>
+  );
+}
