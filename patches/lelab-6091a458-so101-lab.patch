 import { useEffect } from "react";
+import { useApi } from "@/contexts/ApiContext";
 import { useToast } from "@/hooks/use-toast";
 
-const FLAG = "lelab:teleop-stopped";
+const SESSION_KEY = "lelab:teleop-session";
+const PENDING_KEY = "lelab:teleop-stop-pending";
 
 /**
- * One-time confirmation that teleoperation was stopped during the previous
- * page's unload (a browser navigation, reload, or tab close from the
- * teleoperation page set a sessionStorage flag, since React cleanup can't run
- * in those cases). On the next fresh load we surface a toast wherever the user
- * landed, then clear the flag. In-app navigation away from teleop toasts
- * directly and never sets the flag, so this never double-fires.
+ * Reconcile an unload-time stop request. A keepalive request is not proof that
+ * cleanup completed, so this checks the worker's cached exact-session state
+ * and only then reports a clean disconnect.
  */
 const TeleopStopNotice = () => {
   const { toast } = useToast();
+  const { baseUrl, fetchWithHeaders } = useApi();
 
   useEffect(() => {
-    let stopped = false;
+    let sessionId: string | null = null;
     try {
-      stopped = sessionStorage.getItem(FLAG) === "1";
-      if (stopped) sessionStorage.removeItem(FLAG);
+      sessionId = sessionStorage.getItem(PENDING_KEY);
     } catch {
-      /* sessionStorage unavailable — nothing to show */
+      /* sessionStorage unavailable — nothing to reconcile */
     }
-    if (stopped) {
-      toast({
-        title: "Teleoperation stopped",
-        description: "The arm was disconnected cleanly when you left the page.",
-      });
-    }
-  }, [toast]);
+    if (!sessionId) return;
+
+    let cancelled = false;
+    const exactSessionId = sessionId;
+    const readStatus = async () => {
+      const query = new URLSearchParams({ session_id: exactSessionId });
+      const response = await fetchWithHeaders(`${baseUrl}/teleoperation-status?${query}`);
+      const payload = await response.json();
+      if (!response.ok || !payload?.success) {
+        throw new Error(payload?.message ?? "status unavailable");
+      }
+      return payload as { teleoperation_active: boolean };
+    };
+    const reconcile = async () => {
+      try {
+        let status = await readStatus();
+        if (status.teleoperation_active) {
+          const response = await fetchWithHeaders(`${baseUrl}/stop-teleoperation`, {
+            method: "POST",
+            body: JSON.stringify({ session_id: exactSessionId }),
+          });
+          const payload = await response.json();
+          if (!response.ok || !payload?.success) {
+            throw new Error(payload?.message ?? "stop unavailable");
+          }
+          status = await readStatus();
+        }
+        if (status.teleoperation_active) throw new Error("worker is still active");
+        if (cancelled) return;
+        sessionStorage.removeItem(PENDING_KEY);
+        if (sessionStorage.getItem(SESSION_KEY) === exactSessionId) {
+          sessionStorage.removeItem(SESSION_KEY);
+        }
+        toast({
+          title: "Teleoperation stopped",
+          description: "Exact-session status confirms that the arm worker disconnected.",
+        });
+      } catch (error) {
+        if (cancelled) return;
+        toast({
+          title: "Stop not confirmed",
+          description: `${error instanceof Error ? error.message : "Status unavailable"}. Keep the independent stop available.`,
+          variant: "destructive",
+        });
+      }
+    };
+    void reconcile();
+    return () => {
+      cancelled = true;
+    };
+  }, [baseUrl, fetchWithHeaders, toast]);
 
   return null;
 };
