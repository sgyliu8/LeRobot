+def _release_mode_when_process_exits(proc: subprocess.Popen, lease: HardwareLease) -> None:
+    """Finalize an exact inference session only after process exit is proven."""
+    try:
+        proc.wait()
+    except Exception as exc:
+        logger.exception("Inference exit watcher wait failed: %s", exc)
+        if proc.poll() is None:
+            # The child may still own the serial port. Keep both the process
+            # identity and the hardware lease so no other mode can start.
+            return
+    # Reuse the exact-session status finalizer. It clears globals and releases
+    # only if this process and lease still own the current inference session.
+    result = handle_inference_status(lease.token)
+    if not result.get("success") and hardware_mode_gate.matches(lease):
+        logger.error("Inference exited but exact-session finalization failed: %s", result.get("message"))
+
+
+def _terminate_process(proc: subprocess.Popen) -> tuple[bool, str | None]:
+    """Best-effort terminate/kill, reporting whether process exit is confirmed."""
+    if proc.poll() is not None:
+        return True, None
+    try:
+        proc.terminate()
+        try:
+            proc.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            logger.warning("Inference did not exit in 5s; killing")
+            proc.kill()
+            proc.wait(timeout=5)
+    except Exception as exc:
+        logger.exception("Inference process termination failed: %s", exc)
+        if proc.poll() is None:
+            return False, str(exc)
+    return proc.poll() is not None, None
