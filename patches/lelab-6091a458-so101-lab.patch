new file mode 100644
index 0000000000000000000000000000000000000000..a92268e6f246442cdb776d00e29819b4ecfacadd
--- /dev/null
+++ b/frontend/src/components/training/toTrainingRequest.test.ts
@@ -0,0 +1,90 @@
+import { expect, test } from "vitest";
+import { TrainingConfig } from "@/components/training/types";
+import { configToRequest, policyChunkValidationIssue } from "./toTrainingRequest";
+
+const baseConfig: TrainingConfig = {
+  target: { runner: "local" },
+  dataset_repo_id: "local/demo",
+  dataset_video_backend: "pyav",
+  policy_type: "act",
+  steps: 10,
+  batch_size: 2,
+  seed: 1000,
+  num_workers: 0,
+  log_freq: 1,
+  save_freq: 10,
+  save_checkpoint: true,
+  resume: false,
+  wandb_enable: false,
+  wandb_disable_artifact: false,
+  policy_device: "auto",
+  policy_use_amp: false,
+  optimizer_type: "adam",
+  use_policy_training_preset: true,
+};
+
+test("auto device stays an omitted request field while explicit overrides survive", () => {
+  expect(configToRequest(baseConfig).policy_device).toBeUndefined();
+  expect(configToRequest({ ...baseConfig, policy_device: "cpu" }).policy_device).toBe("cpu");
+});
+
+test("the fixed PyAV decoder is explicit in every training request", () => {
+  expect(configToRequest(baseConfig).dataset_video_backend).toBe("pyav");
+});
+
+test("ACT chunk and execution-prefix fields reach the backend request", () => {
+  const request = configToRequest({
+    ...baseConfig,
+    policy_type: "act",
+    policy_chunk_size: 32,
+    policy_n_action_steps: 8,
+  });
+
+  expect(request.policy_chunk_size).toBe(32);
+  expect(request.policy_n_action_steps).toBe(8);
+});
+
+test("switching from GR00T cannot leak hidden hue augmentation into ACT", () => {
+  const request = configToRequest({
+    ...baseConfig, policy_type: "act", dataset_image_transforms_enable: true,
+    dataset_task: "color_sorting_v1",
+  });
+  expect(request.dataset_image_transforms_enable).toBe(false);
+  expect(request.dataset_task).toBe("color_sorting_v1");
+  expect(policyChunkValidationIssue({
+    ...baseConfig, dataset_task: "color_sorting_v1", policy_type: "groot",
+  })).toContain("requires ACT");
+});
+
+test("ACT chunk validation rejects invalid ranges before submission", () => {
+  expect(policyChunkValidationIssue({
+    ...baseConfig,
+    policy_chunk_size: 8,
+    policy_n_action_steps: 9,
+  })).toContain("cannot exceed");
+  expect(policyChunkValidationIssue({
+    ...baseConfig,
+    policy_chunk_size: 1.5,
+    policy_n_action_steps: 1,
+  })).toContain("positive integer");
+  expect(policyChunkValidationIssue({
+    ...baseConfig,
+    policy_type: "diffusion",
+    policy_chunk_size: 1,
+    policy_n_action_steps: 2,
+  })).toBeNull();
+});
+
+test("policy-specific request fields do not leak into unrelated policies", () => {
+  const request = configToRequest({
+    ...baseConfig,
+    policy_type: "diffusion",
+    policy_chunk_size: 32,
+    policy_n_action_steps: 8,
+    policy_base_model_path: "nvidia/GR00T-N1.7-3B",
+  });
+
+  expect(request.policy_chunk_size).toBeUndefined();
+  expect(request.policy_n_action_steps).toBeUndefined();
+  expect(request.policy_base_model_path).toBeUndefined();
+});
diff --git a/frontend/src/components/training/toTrainingRequest.ts b/frontend/src/components/training/toTrainingRequest.ts
new file mode 100644
index 0000000000000000000000000000000000000000..50cbb26dfc3db4f513d37395fd3479b9a0b14b94
--- /dev/null
+++ b/frontend/src/components/training/toTrainingRequest.ts
@@ -0,0 +1,75 @@
+import { TrainingRequest } from "@/lib/jobsApi";
+import { TrainingConfig } from "./types";
+
+export function policyChunkValidationIssue(c: TrainingConfig): string | null {
+  if (c.dataset_task && c.policy_type !== "act") return "Color sorting requires ACT.";
+  if (!["act", "groot"].includes(c.policy_type)) return null;
+  const defaultValue = c.policy_type === "act" ? 100 : 40;
+  const chunkSize = c.policy_chunk_size ?? defaultValue;
+  const actionSteps = c.policy_n_action_steps ?? defaultValue;
+  if (!Number.isInteger(chunkSize) || chunkSize <= 0) {
+    return "Prediction chunk size must be a positive integer.";
+  }
+  if (!Number.isInteger(actionSteps) || actionSteps <= 0) {
+    return "Execution prefix must be a positive integer.";
+  }
+  if (actionSteps > chunkSize) {
+    return "Execution prefix cannot exceed prediction chunk size.";
+  }
+  return null;
+}
+
+/** Convert the visible form state into the backend request contract. */
+export function configToRequest(c: TrainingConfig): TrainingRequest {
+  return {
+    target: c.target,
+    dataset_repo_id: c.dataset_repo_id,
+    dataset_video_backend: c.dataset_video_backend,
+    dataset_task: c.dataset_task,
+    eval_steps: c.dataset_task ? c.eval_steps : 0,
+    policy_type: c.policy_type,
+    steps: c.steps,
+    batch_size: c.batch_size,
+    seed: c.seed,
+    num_workers: c.num_workers,
+    log_freq: c.log_freq,
+    save_freq: c.save_freq,
+    save_checkpoint: c.save_checkpoint,
+    resume: c.resume,
+    wandb_enable: c.wandb_enable,
+    wandb_project: c.wandb_project,
+    wandb_entity: c.wandb_entity,
+    wandb_notes: c.wandb_notes,
+    wandb_mode: c.wandb_mode,
+    wandb_disable_artifact: c.wandb_disable_artifact,
+    // "auto" means that LeRobot should choose inside the execution environment.
+    policy_device: c.policy_device === "auto" ? undefined : c.policy_device,
+    policy_use_amp: c.policy_use_amp,
+    optimizer_type: c.optimizer_type,
+    optimizer_lr: c.optimizer_lr,
+    optimizer_weight_decay: c.optimizer_weight_decay,
+    optimizer_grad_clip_norm: c.optimizer_grad_clip_norm,
+    use_policy_training_preset: c.use_policy_training_preset,
+    // Only GR00T exposes this control. Never forward hidden state from a
+    // previously selected policy into ACT (the default includes hue jitter).
+    dataset_image_transforms_enable: c.policy_type === "groot" && !c.dataset_task
+      ? c.dataset_image_transforms_enable : false,
+    // ACT and GR00T both distinguish prediction horizon from execution prefix.
+    ...(["act", "groot"].includes(c.policy_type)
+      ? {
+          policy_chunk_size: c.policy_chunk_size,
+          policy_n_action_steps: c.policy_n_action_steps,
+        }
+      : {}),
+    // These remaining flags do not exist on other policy configs.
+    ...(c.policy_type === "groot"
+      ? {
+          policy_base_model_path: c.policy_base_model_path,
+          policy_embodiment_tag: c.policy_embodiment_tag,
+          policy_use_relative_actions: c.policy_use_relative_actions,
+          policy_relative_exclude_joints: c.policy_relative_exclude_joints,
+          policy_use_bf16: c.policy_use_bf16,
+        }
+      : {}),
+  };
+}
