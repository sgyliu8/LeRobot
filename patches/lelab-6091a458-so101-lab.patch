@@ -0,0 +1,54 @@
+// @vitest-environment jsdom
+import React, { act } from 'react';
+import { createRoot } from 'react-dom/client';
+import { expect, test, vi } from 'vitest';
+import ActCard from './ActCard';
+import { TrainingConfig } from '../types';
+
+const config: TrainingConfig = {
+  target: { runner: 'local' },
+  dataset_repo_id: 'local/color_sorting_v1',
+  dataset_video_backend: 'pyav',
+  policy_type: 'act',
+  steps: 10,
+  batch_size: 2,
+  num_workers: 0,
+  log_freq: 1,
+  save_freq: 10,
+  save_checkpoint: true,
+  resume: false,
+  wandb_enable: false,
+  wandb_disable_artifact: false,
+  policy_device: 'auto',
+  policy_use_amp: false,
+  use_policy_training_preset: true,
+  policy_chunk_size: 32,
+  policy_n_action_steps: 8,
+};
+
+test('shows separate ACT prediction and execution fields without claiming task-text conditioning', () => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  const host = document.createElement('div');
+  const root = createRoot(host);
+  const updateConfig = vi.fn();
+  try {
+    act(() => root.render(<ActCard config={config} updateConfig={updateConfig} />));
+    expect(host.textContent).toContain('Prediction chunk size');
+    expect(host.textContent).toContain('Execution prefix');
+    expect(host.textContent).toContain('not a language command');
+    expect(host.textContent).toContain('color sorting candidate (32 / 8)');
+    expect((host.querySelector('#act_policy_chunk_size') as HTMLInputElement).value).toBe('32');
+    expect((host.querySelector('#act_policy_n_action_steps') as HTMLInputElement).value).toBe('8');
+    const preset = Array.from(host.querySelectorAll('button')).find((button) =>
+      button.textContent?.includes('color sorting candidate'),
+    );
+    expect(preset).toBeDefined();
+    act(() => preset?.dispatchEvent(new MouseEvent('click', { bubbles: true })));
+    expect(updateConfig).toHaveBeenNthCalledWith(1, 'policy_chunk_size', 32);
+    expect(updateConfig).toHaveBeenNthCalledWith(2, 'policy_n_action_steps', 8);
+    expect(updateConfig).toHaveBeenNthCalledWith(3, 'dataset_image_transforms_enable', false);
+    expect(updateConfig).toHaveBeenNthCalledWith(4, 'dataset_task', 'color_sorting_v1');
+  } finally {
+    act(() => root.unmount());
+  }
+});
