diff --git a/frontend/src/components/TeleopStopNotice.test.tsx b/frontend/src/components/TeleopStopNotice.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..60b0678bb86c0e50138d5c4f77647a3102dae90d
--- /dev/null
+++ b/frontend/src/components/TeleopStopNotice.test.tsx
@@ -0,0 +1,72 @@
+// @vitest-environment jsdom
+import React, { act } from "react";
+import { createRoot } from "react-dom/client";
+import { beforeEach, expect, test, vi } from "vitest";
+import TeleopStopNotice from "./TeleopStopNotice";
+
+const toast = vi.fn();
+const fetchWithHeaders = vi.fn();
+
+vi.mock("@/hooks/use-toast", () => ({ useToast: () => ({ toast }) }));
+vi.mock("@/contexts/ApiContext", () => ({
+  useApi: () => ({ baseUrl: "http://localhost:8000", fetchWithHeaders }),
+}));
+
+beforeEach(() => {
+  sessionStorage.clear();
+  toast.mockReset();
+  fetchWithHeaders.mockReset();
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+});
+
+test("only reports a clean unload stop after exact-session status confirms it", async () => {
+  sessionStorage.setItem("lelab:teleop-stop-pending", "session-a");
+  sessionStorage.setItem("lelab:teleop-session", "session-a");
+  fetchWithHeaders.mockResolvedValue({
+    ok: true,
+    json: async () => ({ success: true, teleoperation_active: false, session_id: "session-a" }),
+  });
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    await act(async () => {
+      root.render(<TeleopStopNotice />);
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+    expect(fetchWithHeaders).toHaveBeenCalledWith(
+      "http://localhost:8000/teleoperation-status?session_id=session-a",
+    );
+    expect(sessionStorage.getItem("lelab:teleop-stop-pending")).toBeNull();
+    expect(sessionStorage.getItem("lelab:teleop-session")).toBeNull();
+    expect(toast).toHaveBeenCalledWith(expect.objectContaining({ title: "Teleoperation stopped" }));
+  } finally {
+    act(() => root.unmount());
+  }
+});
+
+test("retains the token and warns when exact-session status is unavailable", async () => {
+  sessionStorage.setItem("lelab:teleop-stop-pending", "session-b");
+  sessionStorage.setItem("lelab:teleop-session", "session-b");
+  fetchWithHeaders.mockResolvedValue({
+    ok: false,
+    json: async () => ({ success: false, message: "Stale teleoperation session" }),
+  });
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    await act(async () => {
+      root.render(<TeleopStopNotice />);
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+    expect(sessionStorage.getItem("lelab:teleop-stop-pending")).toBe("session-b");
+    expect(sessionStorage.getItem("lelab:teleop-session")).toBe("session-b");
+    expect(toast).toHaveBeenCalledWith(expect.objectContaining({
+      title: "Stop not confirmed",
+      variant: "destructive",
+    }));
+  } finally {
+    act(() => root.unmount());
+  }
+});
diff --git a/frontend/src/components/TeleopStopNotice.tsx b/frontend/src/components/TeleopStopNotice.tsx
index d8a12bd6c53f10d360f77c02d929c8625f32866e..4d4e7688a093c29fc2baccc392537682ca62f9b9 100644
--- a/frontend/src/components/TeleopStopNotice.tsx
+++ b/frontend/src/components/TeleopStopNotice.tsx
@@ -1,34 +1,77 @@
 import { useEffect } from "react";
+import { useApi } from "@/contexts/ApiContext";
 import { useToast } from "@/hooks/use-toast";
 
-const FLAG = "lelab:teleop-stopped";
+const SESSION_KEY = "lelab:teleop-session";
+const PENDING_KEY = "lelab:teleop-stop-pending";
 
 /**
- * One-time confirmation that teleoperation was stopped during the previous
- * page's unload (a browser navigation, reload, or tab close from the
- * teleoperation page set a sessionStorage flag, since React cleanup can't run
- * in those cases). On the next fresh load we surface a toast wherever the user
- * landed, then clear the flag. In-app navigation away from teleop toasts
- * directly and never sets the flag, so this never double-fires.
+ * Reconcile an unload-time stop request. A keepalive request is not proof that
+ * cleanup completed, so this checks the worker's cached exact-session state
+ * and only then reports a clean disconnect.
  */
 const TeleopStopNotice = () => {
   const { toast } = useToast();
+  const { baseUrl, fetchWithHeaders } = useApi();
 
   useEffect(() => {
-    let stopped = false;
+    let sessionId: string | null = null;
     try {
-      stopped = sessionStorage.getItem(FLAG) === "1";
-      if (stopped) sessionStorage.removeItem(FLAG);
+      sessionId = sessionStorage.getItem(PENDING_KEY);
     } catch {
-      /* sessionStorage unavailable — nothing to show */
+      /* sessionStorage unavailable — nothing to reconcile */
     }
-    if (stopped) {
-      toast({
-        title: "Teleoperation stopped",
-        description: "The arm was disconnected cleanly when you left the page.",
-      });
-    }
-  }, [toast]);
+    if (!sessionId) return;
+
+    let cancelled = false;
+    const exactSessionId = sessionId;
+    const readStatus = async () => {
+      const query = new URLSearchParams({ session_id: exactSessionId });
+      const response = await fetchWithHeaders(`${baseUrl}/teleoperation-status?${query}`);
+      const payload = await response.json();
+      if (!response.ok || !payload?.success) {
+        throw new Error(payload?.message ?? "status unavailable");
+      }
+      return payload as { teleoperation_active: boolean };
+    };
+    const reconcile = async () => {
+      try {
+        let status = await readStatus();
+        if (status.teleoperation_active) {
+          const response = await fetchWithHeaders(`${baseUrl}/stop-teleoperation`, {
+            method: "POST",
+            body: JSON.stringify({ session_id: exactSessionId }),
+          });
+          const payload = await response.json();
+          if (!response.ok || !payload?.success) {
+            throw new Error(payload?.message ?? "stop unavailable");
+          }
+          status = await readStatus();
+        }
+        if (status.teleoperation_active) throw new Error("worker is still active");
+        if (cancelled) return;
+        sessionStorage.removeItem(PENDING_KEY);
+        if (sessionStorage.getItem(SESSION_KEY) === exactSessionId) {
+          sessionStorage.removeItem(SESSION_KEY);
+        }
+        toast({
+          title: "Teleoperation stopped",
+          description: "Exact-session status confirms that the arm worker disconnected.",
+        });
+      } catch (error) {
+        if (cancelled) return;
+        toast({
+          title: "Stop not confirmed",
+          description: `${error instanceof Error ? error.message : "Status unavailable"}. Keep the independent stop available.`,
+          variant: "destructive",
+        });
+      }
+    };
+    void reconcile();
+    return () => {
+      cancelled = true;
+    };
+  }, [baseUrl, fetchWithHeaders, toast]);
 
   return null;
 };
