+def _control_context(session_id: str) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:
+    # The lease, active flag and event object form one identity snapshot. Reading
+    # them separately permits an ABA interleaving where an old token is checked
+    # against an old lease but the returned event object belongs to a new run.
+    with _state_lock:
