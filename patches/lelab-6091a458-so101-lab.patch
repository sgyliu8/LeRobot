+    return _recording_evidence_root() / "profiles" / f"{digest}.json"
+
+
+def _profile_payload(request: RecordingRequest) -> dict[str, Any]:
+    return {
+        "schema_version": RECORDING_PROFILE_SCHEMA_VERSION,
+        "dataset_repo_id": request.dataset_repo_id,
+        "single_task": request.single_task,
+        "dataset_fps": request.fps,
+        "video": request.video,
+        "push_to_hub": request.push_to_hub,
+        "streaming_encoding": request.streaming_encoding,
+        "rgb_encoder": request.rgb_encoder.model_dump(),
+        "max_relative_target": dict(request.max_relative_target),
+        "max_relative_target_units": dict(SO101_LIMIT_UNITS),
+        "cameras": {name: cfg.model_dump() for name, cfg in sorted(request.cameras.items())},
+        "robot": {
+            "leader_port": request.leader_port,
+            "follower_port": request.follower_port,
+            "leader_config": request.leader_config,
+            "follower_config": request.follower_config,
+        },
+        "action_semantics": "processed_operator_target",
+        "timestamp_semantics": "nominal_frame_index_div_dataset_fps",
+    }
+
