+import type { ColorSortingSummary as Summary } from "@/lib/datasetApi";
+import ColorSortingSummary from "./ColorSortingSummary";
+
+test("does not infer success from an episode-only color sorting dataset", () => {
+  const html = renderToStaticMarkup(<ColorSortingSummary selected summary={null} />);
+  expect(html).toContain("No human-verified local result summary");
+  expect(html).toContain("Episode presence alone does not establish task success");
+});
