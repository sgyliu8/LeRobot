+import { describe, expect, it } from "vitest";
+
+import type { CameraConfig } from "@/components/recording/CameraConfiguration";
+import type { RobotRecord } from "@/hooks/useRobots";
+import {
+  buildRecordingProfile,
+  buildRecordingRequest,
+  validateRecordingInputs,
+} from "@/lib/recordingRequest";
+
+describe("recording request", () => {
+  it("carries the frozen UI profile and camera roles to the runtime payload", () => {
+    const limits = {
+      shoulder_pan: 5,
+      shoulder_lift: 4,
+      elbow_flex: 3,
+      wrist_flex: 2,
+      wrist_roll: 1,
+      gripper: 6,
+    };
+    const profile = buildRecordingProfile(15, true, 23, limits);
+    const robot: RobotRecord = {
+      name: "LabProfile",
+      leader_port: "LEADER_FIXTURE_PORT",
+      follower_port: "FOLLOWER_FIXTURE_PORT",
+      leader_config: "LabProfile.json",
+      follower_config: "LabProfile.json",
+      cameras: [],
+      is_clean: true,
+    };
+
+    const request = buildRecordingRequest({
+      robot,
+      datasetRepoId: "local/fixture",
+      singleTask: "fixture task",
+      numEpisodes: 1,
+      episodeTimeS: 20,
+      resetTimeS: 10,
+      resume: false,
+      cameras: [
+        {
+          id: "wrist-fixture",
+          device_id: "fixture-wrist-device",
+          name: "arm",
+          type: "opencv",
+          camera_index: 1,
+          width: 640,
+          height: 480,
+          fps: 30,
+          backend: "DSHOW",
+        },
+        {
+          id: "front-fixture",
+          device_id: "fixture-front-device",
+          name: "table_veiw",
+          type: "opencv",
+          camera_index: 2,
+          width: 640,
+          height: 480,
+          fps: 30,
+          backend: "DSHOW",
+        },
+      ],
+      profile,
+    });
+
+    expect(request.fps).toBe(15);
+    expect(request.max_relative_target).toEqual(limits);
+    expect(request.rgb_encoder).toEqual({
+      vcodec: "h264",
+      pix_fmt: "yuv420p",
+      video_backend: "pyav",
+      crf: 23,
+      g: 2,
+    });
+    expect(Object.keys(request.cameras)).toEqual(["arm", "table_veiw"]);
+    expect(request.cameras.arm).toMatchObject({
+      camera_index: 1,
+      width: 640,
+      height: 480,
+      fps: 30,
+      backend: "DSHOW",
+    });
+    expect(request.push_to_hub).toBe(false);
+    expect(request).not.toHaveProperty("test_mode");
+  });
+
+  it.each([undefined, NaN, Infinity, -Infinity, 0, -1, 15, 30])(
+    "requires an explicit finite positive camera FPS (%s), without changing Dataset FPS",
+    (fps) => {
+      const cameras: CameraConfig[] = ["arm", "table_veiw"].map((name, index) => ({
+        id: `fixture-${index}`, device_id: `fixture-device-${index}`,
+        name, type: "opencv", camera_index: index, width: 640, height: 480, fps,
+      }));
+      const limits = {
+        shoulder_pan: 5, shoulder_lift: 5, elbow_flex: 5,
+        wrist_flex: 5, wrist_roll: 5, gripper: 5,
+      };
+      const issues = validateRecordingInputs(15, 23, limits, cameras);
+      expect(issues).toEqual(typeof fps === "number" && Number.isFinite(fps) && fps > 0
+        ? [] : ["Camera index, width, height, and capture FPS must be finite positive values."]);
+      expect(cameras.every((camera) => Object.is(camera.fps, fps))).toBe(true);
+    },
+  );
+
+  it("rejects extra joint keys, non-integer encoding values, and camera identity drift", () => {
+    const cameras = [
+      {
+        id: "a",
+        device_id: "device-a",
+        name: "arm",
+        type: "opencv",
+        camera_index: 1,
+        width: 640,
+        height: 480,
+        fps: 30,
+      },
+      {
+        id: "b",
+        device_id: "device-b",
+        name: "table_veiw",
+        type: "opencv",
+        camera_index: 1,
+        width: 640,
+        height: 480,
+        fps: 30,
+      },
+    ];
+    const issues = validateRecordingInputs(
+      15.5,
+      23.5,
+      {
+        shoulder_pan: 5,
+        shoulder_lift: 5,
+        elbow_flex: 5,
+        wrist_flex: 5,
+        wrist_roll: 5,
+        gripper: 5,
+        extra: 1,
+      },
+      cameras,
+    );
+    expect(issues).toEqual(expect.arrayContaining([
+      "Dataset FPS must be an integer from 1 to 120.",
+      "H.264 CRF must be an integer from 0 to 51.",
+      "Target limits must use exactly the six bare SO-101 joint keys.",
+      "arm and table_veiw must use different camera indices.",
+    ]));
+  });
