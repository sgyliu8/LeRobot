+        requested = {str(key): float(value) for key, value in requested_to_send.items()}
+        effective = {str(key): float(value) for key, value in effective_sent.items()}
+        clipped = {
+            key: effective.get(key) != value
+            for key, value in requested.items()
+            if key in effective
+        }
+        self._last_command = {
+            "to_send": requested,
+            "effective_sent": effective,
+            "clipped": clipped,
+            "clipped_any": any(clipped.values()),
+        }
+
+    def start_attempt(self, *, attempt_id: int, phase_id: int, candidate_episode_index: int) -> None:
+        self._attempt_id = attempt_id
+        self._phase_id = phase_id
+        self._candidate_episode_index = candidate_episode_index
+        self._last_command = None
+        self._last_loop_t = None
+        self._observation_camera_timing = None
+        self._frame_index = 0
+        self.write(
+            {
+                "type": "attempt_start",
+                "attempt_id": attempt_id,
+                "phase_id": phase_id,
+                "candidate_episode_index": candidate_episode_index,
+                "monotonic_s": time.perf_counter(),
+            }
+        )
+
+    def observation(self) -> None:
+        """Snapshot camera host timestamps immediately after get_observation.
+
+        These timestamps are host-side camera completion samples, not exposure
+        times or hardware frame IDs. The explicit association text prevents an
+        audit from presenting them as exact sensor synchronization.
+        """
+
+        now = time.perf_counter()
+        camera_timing: dict[str, Any] = {}
+        for name, camera in getattr(self._robot, "cameras", {}).items():
+            timestamp = getattr(camera, "latest_timestamp", None)
+            if isinstance(timestamp, (int, float)) and math.isfinite(timestamp):
+                previous = self._camera_timestamps.get(name)
+                camera_timing[name] = {
+                    "host_capture_completion_perf_counter_s": float(timestamp),
+                    "arrival_age_at_observation_s": max(0.0, now - float(timestamp)),
+                    "reused_source_timestamp": previous == float(timestamp),
+                    "timestamp_semantics": "host_post_capture_completion_not_exposure",
+                    "association_semantics": (
+                        "sampled_immediately_after_get_observation; exact frame identity unavailable"
+                    ),
+                }
+                self._camera_timestamps[name] = float(timestamp)
+            else:
+                camera_timing[name] = {
+                    "timestamp_semantics": "unavailable",
+                    "association_semantics": "no_camera_frame_id_or_timestamp",
+                }
+        self._observation_camera_timing = camera_timing
+
+    def frame(self, frame: dict[str, Any], dataset_fps: int) -> None:
+        now = time.perf_counter()
+        camera_timing = self._observation_camera_timing or {}
+        row = {
+            "type": "frame",
+            "attempt_id": self._attempt_id,
+            "phase_id": self._phase_id,
+            "candidate_episode_index": self._candidate_episode_index,
+            "frame_index_within_attempt": self._frame_index,
+            "nominal_dataset_timestamp_s": self._frame_index / dataset_fps,
+            "loop_monotonic_s": now,
+            "inter_frame_interval_s": None if self._last_loop_t is None else now - self._last_loop_t,
+            "requested_processed_official_action": frame.get("action"),
+            "measured_state_pre_command": frame.get("observation.state"),
+            "command": self._last_command,
+            "cameras": camera_timing,
+        }
+        self.write(row)
+        self._last_loop_t = now
+        self._observation_camera_timing = None
+        self._frame_index += 1
+
+    def episode_end(self, reason: str, *, saved: bool, saved_episode_index: int | None) -> None:
+        self.write(
+            {
+                "type": "episode_end",
+                "attempt_id": self._attempt_id,
+                "phase_id": self._phase_id,
+                "candidate_episode_index": self._candidate_episode_index,
+                "saved_episode_index": saved_episode_index,
+                "reason": reason,
+                "saved": saved,
+                "frames_observed": self._frame_index,
+                "monotonic_s": time.perf_counter(),
+            }
+        )
+        self._last_command = None
+        self._last_loop_t = None
+        self._observation_camera_timing = None
+        self._frame_index = 0
+
+    def close(self) -> None:
+        self._handle.close()
+
