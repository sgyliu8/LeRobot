-    if (stopped) {
-      toast({
-        title: "Teleoperation stopped",
-        description: "The arm was disconnected cleanly when you left the page.",
-      });
-    }
-  }, [toast]);
+    if (!sessionId) return;
+
+    let cancelled = false;
+    const exactSessionId = sessionId;
+    const readStatus = async () => {
+      const query = new URLSearchParams({ session_id: exactSessionId });
+      const response = await fetchWithHeaders(`${baseUrl}/teleoperation-status?${query}`);
+      const payload = await response.json();
+      if (!response.ok || !payload?.success) {
+        throw new Error(payload?.message ?? "status unavailable");
+      }
+      return payload as { teleoperation_active: boolean };
+    };
+    const reconcile = async () => {
+      try {
+        let status = await readStatus();
+        if (status.teleoperation_active) {
+          const response = await fetchWithHeaders(`${baseUrl}/stop-teleoperation`, {
+            method: "POST",
+            body: JSON.stringify({ session_id: exactSessionId }),
+          });
+          const payload = await response.json();
+          if (!response.ok || !payload?.success) {
+            throw new Error(payload?.message ?? "stop unavailable");
+          }
+          status = await readStatus();
+        }
+        if (status.teleoperation_active) throw new Error("worker is still active");
+        if (cancelled) return;
+        sessionStorage.removeItem(PENDING_KEY);
+        if (sessionStorage.getItem(SESSION_KEY) === exactSessionId) {
+          sessionStorage.removeItem(SESSION_KEY);
+        }
