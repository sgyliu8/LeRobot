+def read_recording_profile(repo_id: str) -> dict[str, Any] | None:
+    """Read the ignored local profile used to authorize an exact resume."""
+
+    canonical = _canonicalize_repo_id(repo_id)
+    path = _profile_path(canonical)
+    if not path.is_file():
+        return None
+    try:
+        payload = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return None
+    if not isinstance(payload, dict) or payload.get("dataset_repo_id") != canonical:
+        return None
+    return payload
+
+
+def read_color_sorting_summary(repo_id: str) -> dict[str, Any] | None:
+    """Read a bounded, local, human-labelled result summary without repairing data."""
+
+    canonical = _canonicalize_repo_id(repo_id)
+    path = _color_sorting_summary_path(canonical)
+    if not path.is_file() or path.is_symlink():
+        return None
+    try:
+        if path.stat().st_size > 1024 * 1024:
+            return None
+        payload = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return None
+    if (
+        not isinstance(payload, dict)
+        or payload.get("schema_version") != "1.0"
+        or payload.get("task_id") != "color_sorting_v1"
+        or payload.get("dataset_repo_id") != canonical
+        or payload.get("stage") not in {"C0", "C1", "C2", "C3", "C4"}
+        or not re.fullmatch(r"[0-9a-f]{64}", str(payload.get("profile_sha256", "")))
+    ):
+        return None
+    policy = payload.get("policy")
+    evaluation = payload.get("evaluation")
+    required_counts = {
+        "attempts_total",
+        "attempts_started",
+        "preflight_rejected",
+        "placements_started",
+        "correct_placements",
+    }
+    if (
+        not isinstance(policy, dict)
+        or policy.get("type") != "act"
+        or isinstance(policy.get("chunk_size"), bool)
+        or not isinstance(policy.get("chunk_size"), int)
+        or isinstance(policy.get("n_action_steps"), bool)
+        or not isinstance(policy.get("n_action_steps"), int)
+        or policy["chunk_size"] <= 0
+        or policy["n_action_steps"] <= 0
+        or policy["n_action_steps"] > policy["chunk_size"]
+        or policy.get("task_text_consumed") is not False
+        or not isinstance(evaluation, dict)
+        or any(
+            isinstance(evaluation.get(key), bool)
+            or not isinstance(evaluation.get(key), int)
+            or evaluation[key] < 0
+            for key in required_counts
+        )
+    ):
+        return None
+    human_outcomes = evaluation.get("human_outcomes")
+    if not isinstance(human_outcomes, dict) or any(
+        isinstance(human_outcomes.get(key), bool)
+        or not isinstance(human_outcomes.get(key), int)
+        or human_outcomes[key] < 0
+        for key in ("success", "failure", "abort", "unknown")
+    ):
+        return None
+    if (
+        evaluation["attempts_total"]
+        != evaluation["attempts_started"] + evaluation["preflight_rejected"]
+        or sum(human_outcomes[key] for key in ("success", "failure", "abort", "unknown"))
+        != evaluation["attempts_started"]
+        or evaluation["correct_placements"] != human_outcomes["success"]
+        or evaluation["placements_started"] > evaluation["attempts_started"]
+        or evaluation["correct_placements"] > evaluation["placements_started"]
+    ):
+        return None
+    return {
+        "schema_version": "1.0",
+        "task_id": "color_sorting_v1",
+        "stage": payload["stage"],
+        "dataset_repo_id": canonical,
+        "profile_sha256": payload["profile_sha256"],
+        "policy": {
+            "type": "act",
+            "chunk_size": policy["chunk_size"],
+            "n_action_steps": policy["n_action_steps"],
+            "task_text_consumed": False,
+        },
+        "evaluation": {
+            **{key: evaluation[key] for key in sorted(required_counts)},
+            "human_outcomes": {
+                key: human_outcomes[key] for key in ("success", "failure", "abort", "unknown")
+            },
+        },
+    }
+
+
+def _persist_profile(request: RecordingRequest) -> None:
+    path = _profile_path(request.dataset_repo_id)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    payload = json.dumps(_profile_payload(request), indent=2, sort_keys=True)
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(payload, encoding="utf-8")
+    temporary.replace(path)
+
+
+def _validate_resume_profile(request: RecordingRequest) -> None:
+    path = _profile_path(request.dataset_repo_id)
+    if not path.is_file():
+        raise ValueError(
+            "Cannot resume safely: the local recording profile is missing. "
+            "Browse the dataset read-only; do not guess its limits, labels, cameras, or encoder settings."
+        )
+    try:
+        existing = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise ValueError(f"Cannot resume safely: unreadable recording profile: {exc}") from exc
+    requested = _profile_payload(request)
+    if existing != requested:
+        changed = sorted(key for key in requested if existing.get(key) != requested.get(key))
+        raise ValueError(f"Cannot resume with a changed recording profile: {changed}")
+
+
+def _effective_config(request: RecordingRequest) -> dict[str, Any]:
+    payload = _profile_payload(request)
+    payload.update(
+        {
+            "resume": request.resume,
+            "additional_episodes": int(request.num_episodes),
+            "push_to_hub": False,
+            "video": request.video,
+        }
+    )
+    return payload
+
