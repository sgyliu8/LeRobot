+// @vitest-environment jsdom
+import React, { act } from "react";
+import { createRoot } from "react-dom/client";
+import { beforeEach, expect, test, vi } from "vitest";
+import TeleopStopNotice from "./TeleopStopNotice";
+
+const toast = vi.fn();
+const fetchWithHeaders = vi.fn();
+
+vi.mock("@/hooks/use-toast", () => ({ useToast: () => ({ toast }) }));
+vi.mock("@/contexts/ApiContext", () => ({
+  useApi: () => ({ baseUrl: "http://localhost:8000", fetchWithHeaders }),
+}));
+
+beforeEach(() => {
+  sessionStorage.clear();
+  toast.mockReset();
+  fetchWithHeaders.mockReset();
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+});
+
+test("only reports a clean unload stop after exact-session status confirms it", async () => {
+  sessionStorage.setItem("lelab:teleop-stop-pending", "session-a");
+  sessionStorage.setItem("lelab:teleop-session", "session-a");
+  fetchWithHeaders.mockResolvedValue({
+    ok: true,
+    json: async () => ({ success: true, teleoperation_active: false, session_id: "session-a" }),
+  });
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    await act(async () => {
+      root.render(<TeleopStopNotice />);
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+    expect(fetchWithHeaders).toHaveBeenCalledWith(
+      "http://localhost:8000/teleoperation-status?session_id=session-a",
+    );
+    expect(sessionStorage.getItem("lelab:teleop-stop-pending")).toBeNull();
+    expect(sessionStorage.getItem("lelab:teleop-session")).toBeNull();
+    expect(toast).toHaveBeenCalledWith(expect.objectContaining({ title: "Teleoperation stopped" }));
+  } finally {
+    act(() => root.unmount());
+  }
+});
+
+test("retains the token and warns when exact-session status is unavailable", async () => {
+  sessionStorage.setItem("lelab:teleop-stop-pending", "session-b");
+  sessionStorage.setItem("lelab:teleop-session", "session-b");
+  fetchWithHeaders.mockResolvedValue({
+    ok: false,
+    json: async () => ({ success: false, message: "Stale teleoperation session" }),
+  });
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    await act(async () => {
+      root.render(<TeleopStopNotice />);
+      await Promise.resolve();
+      await Promise.resolve();
+    });
+    expect(sessionStorage.getItem("lelab:teleop-stop-pending")).toBe("session-b");
+    expect(sessionStorage.getItem("lelab:teleop-session")).toBe("session-b");
+    expect(toast).toHaveBeenCalledWith(expect.objectContaining({
+      title: "Stop not confirmed",
+      variant: "destructive",
+    }));
+  } finally {
+    act(() => root.unmount());
+  }
+});
