@@ -0,0 +1,127 @@
+import { describe, expect, it } from "vitest";
+
+import type { RobotRecord } from "@/hooks/useRobots";
+import {
+  buildRecordingProfile,
+  buildRecordingRequest,
+  validateRecordingInputs,
+} from "@/lib/recordingRequest";
+
+describe("recording request", () => {
+  it("carries the frozen UI profile and camera roles to the runtime payload", () => {
+    const limits = {
+      shoulder_pan: 5,
+      shoulder_lift: 4,
+      elbow_flex: 3,
+      wrist_flex: 2,
+      wrist_roll: 1,
+      gripper: 6,
+    };
+    const profile = buildRecordingProfile(15, true, 23, limits);
+    const robot: RobotRecord = {
+      name: "LabProfile",
+      leader_port: "LEADER_FIXTURE_PORT",
+      follower_port: "FOLLOWER_FIXTURE_PORT",
+      leader_config: "LabProfile.json",
+      follower_config: "LabProfile.json",
+      cameras: [],
+      is_clean: true,
+    };
+
+    const request = buildRecordingRequest({
+      robot,
+      datasetRepoId: "local/fixture",
+      singleTask: "fixture task",
+      numEpisodes: 1,
+      episodeTimeS: 20,
+      resetTimeS: 10,
+      resume: false,
+      cameras: [
+        {
+          name: "arm",
+          type: "opencv",
+          camera_index: 1,
+          width: 640,
+          height: 480,
+          fps: 30,
+          backend: "DSHOW",
+        },
+        {
+          name: "table_veiw",
+          type: "opencv",
+          camera_index: 2,
+          width: 640,
+          height: 480,
+          fps: 30,
+          backend: "DSHOW",
+        },
+      ],
+      profile,
+    });
+
+    expect(request.fps).toBe(15);
+    expect(request.max_relative_target).toEqual(limits);
+    expect(request.rgb_encoder).toEqual({
+      vcodec: "h264",
+      pix_fmt: "yuv420p",
+      video_backend: "pyav",
+      crf: 23,
+      g: 2,
+    });
+    expect(Object.keys(request.cameras)).toEqual(["arm", "table_veiw"]);
+    expect(request.cameras.arm).toMatchObject({
+      camera_index: 1,
+      width: 640,
+      height: 480,
+      fps: 30,
+      backend: "DSHOW",
+    });
