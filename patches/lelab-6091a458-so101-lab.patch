+def _track_process_children(proc: subprocess.Popen) -> None:
+    children = getattr(proc, "_lelab_owned_children", None)
+    if not isinstance(children, dict) or proc.poll() is not None:
+        return
+    try:
+        for child in psutil.Process(proc.pid).children(recursive=True):
+            # psutil Process binds PID + creation time, including its mutation
+            # methods; a recycled PID cannot become a new stop target.
+            children[(child.pid, child.create_time())] = child
+    except psutil.NoSuchProcess:
+        pass
+
+
+def _process_tree_exited(proc: subprocess.Popen) -> bool:
+    _track_process_children(proc)
+    if proc.poll() is None:
+        return False
+    children = getattr(proc, "_lelab_owned_children", {})
+    if isinstance(children, dict):
+        for child in children.values():
+            if child.is_running():
+                return False
+    return True
+
+
+def _terminate_process(proc: subprocess.Popen) -> tuple[bool, str | None]:
+    """Best-effort terminate/kill, reporting whether process exit is confirmed."""
+    if _process_tree_exited(proc):
+        return True, None
+    try:
+        children = getattr(proc, "_lelab_owned_children", {})
+        if isinstance(children, dict) and children:
+            owned = list(children.values())
+            for child in reversed(owned):
+                with contextlib.suppress(psutil.NoSuchProcess):
+                    child.terminate()
+            _, alive = psutil.wait_procs(owned, timeout=5)
+            for child in alive:
+                with contextlib.suppress(psutil.NoSuchProcess):
+                    child.kill()
+            if alive:
+                _, alive = psutil.wait_procs(alive, timeout=5)
+            if alive:
+                return False, "Inference child process exit could not be confirmed"
+        proc.terminate()
+        try:
+            proc.wait(timeout=5)
+        except subprocess.TimeoutExpired:
+            logger.warning("Inference did not exit in 5s; killing")
+            proc.kill()
+            proc.wait(timeout=5)
+    except Exception as exc:
