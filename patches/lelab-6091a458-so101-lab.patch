+@pytest.mark.skipif(os.name != "nt", reason="Windows junction fallback")
+def test_checkpoint_alias_falls_back_to_junction_and_updates_twice(monkeypatch, tmp_path) -> None:
+    from lelab.train_worker import update_last_checkpoint_portable
+
+    checkpoints = tmp_path / "checkpoints"
+    first = checkpoints / "001000"
+    second = checkpoints / "001001"
+    first.mkdir(parents=True)
+    second.mkdir()
+
+    def privilege_error(*_args, **_kwargs):
+        error = OSError("symlink privilege unavailable")
+        error.winerror = 1314
+        raise error
+
+    monkeypatch.setattr(Path, "symlink_to", privilege_error)
+    alias = update_last_checkpoint_portable(first)
+    assert os.path.isjunction(alias)
+    assert alias.resolve() == first.resolve()
+
+    alias = update_last_checkpoint_portable(second)
+    assert os.path.isjunction(alias)
+    assert alias.resolve() == second.resolve()
+
+
+def test_checkpoint_alias_does_not_hide_unrelated_errors(monkeypatch, tmp_path) -> None:
+    from lelab.train_worker import update_last_checkpoint_portable
+
+    checkpoint = tmp_path / "checkpoints" / "000001"
+    checkpoint.mkdir(parents=True)
+
+    def disk_error(*_args, **_kwargs):
+        error = OSError("disk failure")
+        error.winerror = 5
+        raise error
+
+    monkeypatch.setattr(Path, "symlink_to", disk_error)
+    with pytest.raises(OSError, match="disk failure"):
+        update_last_checkpoint_portable(checkpoint)
+
+
+def test_checkpoint_alias_refuses_to_replace_an_ordinary_directory(tmp_path) -> None:
+    from lelab.train_worker import update_last_checkpoint_portable
+
+    checkpoint = tmp_path / "checkpoints" / "000001"
+    checkpoint.mkdir(parents=True)
+    (checkpoint.parent / "last").mkdir()
+    with pytest.raises(FileExistsError, match="non-link"):
+        update_last_checkpoint_portable(checkpoint)
