+    expect(issues).toEqual(expect.arrayContaining([
+      "Dataset FPS must be an integer from 1 to 120.",
+      "H.264 CRF must be an integer from 0 to 51.",
+      "Target limits must use exactly the six bare SO-101 joint keys.",
+      "arm and table_veiw must use different camera indices.",
+    ]));
+  });
+});
diff --git a/frontend/src/lib/recordingRequest.ts b/frontend/src/lib/recordingRequest.ts
new file mode 100644
index 0000000000000000000000000000000000000000..ae4daf7140380f85e8b4f62d3183e58ce554b16c
--- /dev/null
+++ b/frontend/src/lib/recordingRequest.ts
@@ -0,0 +1,143 @@
+import type { CameraConfig } from "@/components/recording/CameraConfiguration";
+import type { RecordingProfile, RobotRecord } from "@/hooks/useRobots";
+
+interface BuildRecordingRequestOptions {
+  robot: RobotRecord;
+  datasetRepoId: string;
+  singleTask: string;
+  numEpisodes: number;
+  episodeTimeS: number;
+  resetTimeS: number;
+  resume: boolean;
+  cameras: CameraConfig[];
+  profile: RecordingProfile;
+}
+
+export const SO101_JOINT_KEYS = [
+  "shoulder_pan",
+  "shoulder_lift",
+  "elbow_flex",
+  "wrist_flex",
+  "wrist_roll",
+  "gripper",
+] as const;
+
+export const validateRecordingInputs = (
+  datasetFps: number,
+  encoderCrf: number,
+  maxRelativeTarget: Record<string, number>,
+  cameras: CameraConfig[],
+): string[] => {
+  const issues: string[] = [];
+  if (!Number.isInteger(datasetFps) || datasetFps <= 0 || datasetFps > 120) {
+    issues.push("Dataset FPS must be an integer from 1 to 120.");
+  }
+  if (!Number.isInteger(encoderCrf) || encoderCrf < 0 || encoderCrf > 51) {
+    issues.push("H.264 CRF must be an integer from 0 to 51.");
+  }
+  const expectedJoints = new Set<string>(SO101_JOINT_KEYS);
+  const actualJoints = Object.keys(maxRelativeTarget);
+  if (
+    actualJoints.length !== expectedJoints.size ||
+    actualJoints.some((key) => !expectedJoints.has(key))
+  ) {
+    issues.push("Target limits must use exactly the six bare SO-101 joint keys.");
+  } else if (
+    SO101_JOINT_KEYS.some(
+      (key) => !Number.isFinite(maxRelativeTarget[key]) || maxRelativeTarget[key] <= 0,
+    )
+  ) {
+    issues.push("Every target limit must be finite and greater than zero.");
+  }
+  const expectedCameras = new Set(["arm", "table_veiw"]);
+  const names = cameras.map((camera) => camera.name);
+  if (
+    names.length !== expectedCameras.size ||
+    names.some((name) => !expectedCameras.has(name))
+  ) {
+    issues.push("Recording requires exactly arm (wrist) and table_veiw (front).");
+  }
+  if (new Set(cameras.map((camera) => String(camera.camera_index))).size !== cameras.length) {
+    issues.push("arm and table_veiw must use different camera indices.");
+  }
+  if (
+    cameras.some(
+      (camera) =>
+        !Number.isFinite(Number(camera.camera_index)) ||
+        !Number.isFinite(camera.width) ||
+        camera.width <= 0 ||
+        !Number.isFinite(camera.height) ||
+        camera.height <= 0 ||
+        !Number.isFinite(camera.fps) ||
+        camera.fps <= 0,
+    )
+  ) {
+    issues.push("Camera index, width, height, and capture FPS must be finite positive values.");
+  }
+  return issues;
+};
+
+export const buildRecordingProfile = (
+  datasetFps: number,
+  streamingEncoding: boolean,
+  encoderCrf: number,
+  maxRelativeTarget: Record<string, number>,
+): RecordingProfile => ({
+  dataset_fps: datasetFps,
+  streaming_encoding: streamingEncoding,
+  rgb_encoder: {
+    vcodec: "h264",
+    pix_fmt: "yuv420p",
+    video_backend: "pyav",
+    crf: encoderCrf,
+    g: 2,
+  },
+  max_relative_target: { ...maxRelativeTarget },
+});
+
+export const buildRecordingRequest = ({
+  robot,
+  datasetRepoId,
+  singleTask,
+  numEpisodes,
+  episodeTimeS,
+  resetTimeS,
+  resume,
+  cameras,
+  profile,
+}: BuildRecordingRequestOptions) => {
+  const cameraPayload = Object.fromEntries(
+    cameras.map((camera) => [
+      camera.name,
+      {
+        type: camera.type,
+        camera_index: camera.camera_index,
+        width: camera.width,
+        height: camera.height,
+        fps: camera.fps,
+        ...(camera.fourcc ? { fourcc: camera.fourcc } : {}),
+        ...(camera.backend ? { backend: camera.backend } : {}),
+      },
+    ]),
+  );
+
+  return {
+    leader_port: robot.leader_port,
+    follower_port: robot.follower_port,
+    leader_config: robot.leader_config,
+    follower_config: robot.follower_config,
+    dataset_repo_id: datasetRepoId,
+    single_task: singleTask,
+    num_episodes: numEpisodes,
+    episode_time_s: episodeTimeS,
+    reset_time_s: resetTimeS,
+    fps: profile.dataset_fps,
+    video: true,
+    push_to_hub: false,
+    resume,
+    streaming_encoding: profile.streaming_encoding,
+    cameras: cameraPayload,
+    max_relative_target: { ...profile.max_relative_target },
+    rgb_encoder: { ...profile.rgb_encoder },
+  };
+};
