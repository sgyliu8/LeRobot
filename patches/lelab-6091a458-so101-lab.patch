+const mocks = vi.hoisted(() => ({
+  listJobs: vi.fn(), listHubJobs: vi.fn(), fetchWithHeaders: vi.fn(),
+}));
+vi.mock("@/contexts/ApiContext", () => ({ useApi: () => ({ baseUrl: "", fetchWithHeaders: mocks.fetchWithHeaders }) }));
+vi.mock("@/hooks/use-toast", () => ({ useToast: () => ({ toast: () => {} }) }));
+vi.mock("@/hooks/useRobots", () => ({ useRobots: () => ({ selectedRecord: null }) }));
+vi.mock("@/hooks/useJobsChangedSignal", () => ({ useJobsChangedSignal: () => {} }));
+vi.mock("@/lib/jobsApi", () => ({
+  listJobs: mocks.listJobs, listHubJobs: mocks.listHubJobs,
+  deleteJob: vi.fn(), resumeCheckpoint: vi.fn(), stopJob: vi.fn(),
