+    return () => video.cancelVideoFrameCallback?.(handle);
+  }, [identity, fromTs, toTs]);
+
+  const clampToWindow = (video: HTMLVideoElement) => {
+    if (video.currentTime < fromTs || video.currentTime >= toTs) {
+      video.currentTime = fromTs;
+    }
+  };
+
+  return (
