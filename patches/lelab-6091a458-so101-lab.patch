+        toast({
+          title: "Stop not confirmed",
+          description: `${error instanceof Error ? error.message : "Status unavailable"}. Keep the independent stop available.`,
+          variant: "destructive",
+        });
+      }
+    };
+    void reconcile();
+    return () => {
+      cancelled = true;
+    };
+  }, [baseUrl, fetchWithHeaders, toast]);
 
