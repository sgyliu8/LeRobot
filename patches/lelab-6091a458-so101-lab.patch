+import React from "react";
+import { renderToStaticMarkup } from "react-dom/server";
+import { expect, test } from "vitest";
+import type { ColorSortingSummary as Summary } from "@/lib/datasetApi";
+import ColorSortingSummary from "./ColorSortingSummary";
+
+test("does not infer success from an episode-only color sorting dataset", () => {
+  const html = renderToStaticMarkup(<ColorSortingSummary selected summary={null} />);
+  expect(html).toContain("No human-verified local result summary");
+  expect(html).toContain("Episode presence alone does not establish task success");
+});
+
+test("renders all human outcome denominators from the checked local summary", () => {
+  const summary: Summary = {
+    schema_version: "1.0",
+    task_id: "color_sorting_v1",
+    stage: "C1",
+    dataset_repo_id: "local/color_sorting_v1_fixture",
+    profile_sha256: "a".repeat(64),
+    policy: { type: "act", chunk_size: 32, n_action_steps: 8, task_text_consumed: false },
+    evaluation: {
+      attempts_total: 5,
+      attempts_started: 4,
+      preflight_rejected: 1,
+      placements_started: 2,
+      correct_placements: 1,
+      human_outcomes: { success: 1, failure: 1, abort: 1, unknown: 1 },
+    },
+  };
+  const text = renderToStaticMarkup(<ColorSortingSummary selected summary={summary} />);
+  for (const label of ["Started", "Correct", "Failure", "Abort", "Unknown", "Preflight rejected"]) {
+    expect(text).toContain(label);
+  }
+  expect(text).toContain("ACT chunk 32");
+  expect(text).toContain("execute 8");
+});
