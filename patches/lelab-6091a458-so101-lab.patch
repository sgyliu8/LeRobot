+def _scope_header(scope: Scope, name: bytes) -> str | None:
+    for key, value in scope.get("headers", []):
+        if key.lower() == name:
+            return value.decode("latin-1")
+    return None
+
+
+def _trusted_host(raw_host: str | None) -> bool:
+    if not raw_host:
+        return False
+    try:
+        parsed = urlsplit(f"//{raw_host}")
+        return parsed.hostname in _TRUSTED_HOSTNAMES and parsed.port in (None, 8000)
+    except ValueError:
+        return False
