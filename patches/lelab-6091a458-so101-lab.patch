diff --git a/frontend/src/components/ui/number-input.test.tsx b/frontend/src/components/ui/number-input.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..db9b163ab17350a33da23ff74e08a1e23917ae9e
--- /dev/null
+++ b/frontend/src/components/ui/number-input.test.tsx
@@ -0,0 +1,28 @@
+// @vitest-environment jsdom
+import React, { act } from "react";
+import { createRoot } from "react-dom/client";
+import { expect, test, vi } from "vitest";
+import { NumberInput } from "./number-input";
+
+test("actual input events never silently truncate decimal or exponent notation", () => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  const host = document.createElement("div");
+  document.body.append(host);
+  const root = createRoot(host);
+  const changed = vi.fn();
+  try {
+    act(() => root.render(<NumberInput value={32} onChange={changed} />));
+    const input = host.querySelector("input")!;
+    const setter = Object.getOwnPropertyDescriptor(HTMLInputElement.prototype, "value")!.set!;
+    for (const [raw, expected] of [["1.5", 1.5], ["1e3", 1000]] as const) {
+      act(() => {
+        setter.call(input, raw);
+        input.dispatchEvent(new Event("input", { bubbles: true }));
+      });
+      expect(changed).toHaveBeenLastCalledWith(expected);
+    }
+  } finally {
+    act(() => root.unmount());
+    host.remove();
+  }
