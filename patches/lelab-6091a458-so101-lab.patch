+class _StopAwareRobot:
+    def __init__(
+        self,
+        robot: Any,
+        stop_event: threading.Event,
+        trace: _RecordingTrace,
+        command_lock: threading.Lock,
+    ):
+        self._robot = robot
+        self._stop_event = stop_event
+        self._trace = trace
+        self._command_lock = command_lock
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._robot, name)
+
+    def get_observation(self):
+        if self._stop_event.is_set():
+            raise _StopRequestedError()
+        observation = self._robot.get_observation()
+        if self._stop_event.is_set():
+            raise _StopRequestedError()
+        self._trace.observation()
+        return observation
+
+    def send_action(self, action):
+        with self._command_lock:
+            if self._stop_event.is_set():
+                raise _StopRequestedError()
+            effective = self._robot.send_action(action)
+            self._trace.command(action, effective)
+            return effective
+
+
+class _TracingDataset:
+    def __init__(self, dataset: LeRobotDataset, trace: _RecordingTrace):
+        self._dataset = dataset
+        self._trace = trace
+
+    def __getattr__(self, name: str) -> Any:
+        return getattr(self._dataset, name)
+
+    def add_frame(self, frame: dict[str, Any]) -> None:
+        self._dataset.add_frame(frame)
+        self._trace.frame(frame, self._dataset.fps)
+
+
+def _open_phase(web_events: dict[str, Any], lease: HardwareLease, phase: str) -> int:
+    """Atomically publish one control window and its generation."""
+
+    global current_phase, phase_start_time
+
+    with _state_lock:
+        if _recording_lease != lease or recording_events is not web_events:
+            raise _StopRequestedError()
+        with web_events["_decision_lock"]:
+            if web_events["_stop_event"].is_set():
+                web_events["_decision"] = "stop"
+                web_events["stop_recording"] = True
+                web_events["exit_early"] = True
+                web_events["_phase_open"] = False
+                raise _StopRequestedError()
+            web_events["_phase_id"] += 1
+            web_events["_phase_name"] = phase
+            web_events["_phase_open"] = True
+            web_events["_decision"] = None
+            web_events["exit_early"] = False
+            web_events["rerecord_episode"] = False
+            current_phase = phase
+            phase_start_time = time.time()
+            return int(web_events["_phase_id"])
+
+
+def _close_phase_and_decide(web_events: dict[str, Any], phase_id: int, *, default: str) -> str:
+    """Close one generation before consuming its decision."""
+
+    with web_events["_decision_lock"]:
+        if web_events["_phase_id"] != phase_id:
+            raise RuntimeError("Recording phase generation changed unexpectedly")
+        web_events["_phase_open"] = False
+        if web_events["_stop_event"].is_set() or web_events["_decision"] == "stop":
+            return "stop"
+        return web_events["_decision"] or default
+
+
+def _raise_if_stopping(web_events: dict[str, Any]) -> None:
+    if web_events["_stop_event"].is_set():
+        raise _StopRequestedError()
+
