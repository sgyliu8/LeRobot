+          width: 640,
+          height: 480,
+          fps: 30,
+          backend: "DSHOW",
+        },
+        {
+          name: "table_veiw",
+          type: "opencv",
+          camera_index: 2,
+          width: 640,
+          height: 480,
+          fps: 30,
+          backend: "DSHOW",
+        },
+      ],
+      profile,
+    });
+
+    expect(request.fps).toBe(15);
+    expect(request.max_relative_target).toEqual(limits);
+    expect(request.rgb_encoder).toEqual({
+      vcodec: "h264",
+      pix_fmt: "yuv420p",
+      video_backend: "pyav",
+      crf: 23,
+      g: 2,
+    });
+    expect(Object.keys(request.cameras)).toEqual(["arm", "table_veiw"]);
+    expect(request.cameras.arm).toMatchObject({
+      camera_index: 1,
+      width: 640,
+      height: 480,
+      fps: 30,
+      backend: "DSHOW",
+    });
+    expect(request.push_to_hub).toBe(false);
+    expect(request).not.toHaveProperty("test_mode");
+  });
+
+  it("rejects extra joint keys, non-integer encoding values, and camera identity drift", () => {
+    const cameras = [
+      {
+        id: "a",
+        device_id: "device-a",
+        name: "arm",
+        type: "opencv",
+        camera_index: 1,
+        width: 640,
+        height: 480,
+        fps: 30,
+      },
+      {
+        id: "b",
+        device_id: "device-b",
+        name: "table_veiw",
+        type: "opencv",
+        camera_index: 1,
+        width: 640,
+        height: 480,
+        fps: 30,
+      },
+    ];
+    const issues = validateRecordingInputs(
+      15.5,
+      23.5,
+      {
+        shoulder_pan: 5,
+        shoulder_lift: 5,
+        elbow_flex: 5,
+        wrist_flex: 5,
+        wrist_roll: 5,
+        gripper: 5,
+        extra: 1,
