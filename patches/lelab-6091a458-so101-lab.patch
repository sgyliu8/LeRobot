+// @vitest-environment jsdom
+import React, { act } from "react";
+import { createRoot } from "react-dom/client";
+import { expect, test, vi } from "vitest";
+import FilmStrip from "./FilmStrip";
+import { getThumbnails } from "@/lib/datasetApi";
+
+vi.mock("@/contexts/ApiContext", () => ({
+  useApi: () => ({ baseUrl: "http://localhost:8000", fetchWithHeaders: vi.fn() }),
+}));
+vi.mock("@/lib/datasetApi", async (importOriginal) => {
+  const original = await importOriginal<typeof import("@/lib/datasetApi")>();
+  return { ...original, getThumbnails: vi.fn() };
+});
+
+test("surfaces partial thumbnail decode instead of silently showing a shorter strip", async () => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  vi.mocked(getThumbnails).mockResolvedValue({
+    success: true,
+    complete: false,
+    issues: ["decoded 1 of 2 requested thumbnails"],
+    episode_index: 0,
+    camera: "arm",
+    thumbnails: [{ frame_index: 0, data_uri: "data:image/png;base64,AA==" }],
+  });
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    act(() => {
+      root.render(
+        <FilmStrip
+          repoId="local/demo"
+          episodeIndex={0}
+          camera="arm"
+          currentFrame={0}
+          onSeekFrame={() => undefined}
+          count={2}
+        />,
+      );
+    });
+    await vi.waitFor(() => {
+      expect(host.textContent).toContain("Partial video evidence");
+      expect(host.textContent).toContain("decoded 1 of 2 requested thumbnails");
+    });
+  } finally {
+    act(() => root.unmount());
+  }
+});
