+import { expect, test } from "vitest";
+import { TrainingConfig } from "@/components/training/types";
+import { configToRequest, policyChunkValidationIssue } from "./toTrainingRequest";
+
+const baseConfig: TrainingConfig = {
+  target: { runner: "local" },
+  dataset_repo_id: "local/demo",
+  dataset_video_backend: "pyav",
+  policy_type: "act",
+  steps: 10,
+  batch_size: 2,
+  seed: 1000,
+  num_workers: 0,
+  log_freq: 1,
+  save_freq: 10,
+  save_checkpoint: true,
+  resume: false,
+  wandb_enable: false,
+  wandb_disable_artifact: false,
+  policy_device: "auto",
+  policy_use_amp: false,
+  optimizer_type: "adam",
+  use_policy_training_preset: true,
+};
+
+test("auto device stays an omitted request field while explicit overrides survive", () => {
+  expect(configToRequest(baseConfig).policy_device).toBeUndefined();
+  expect(configToRequest({ ...baseConfig, policy_device: "cpu" }).policy_device).toBe("cpu");
+});
+
+test("the fixed PyAV decoder is explicit in every training request", () => {
+  expect(configToRequest(baseConfig).dataset_video_backend).toBe("pyav");
+});
+
+test("ACT chunk and execution-prefix fields reach the backend request", () => {
+  const request = configToRequest({
+    ...baseConfig,
+    policy_type: "act",
+    policy_chunk_size: 32,
+    policy_n_action_steps: 8,
+  });
+
+  expect(request.policy_chunk_size).toBe(32);
+  expect(request.policy_n_action_steps).toBe(8);
+});
+
+test("switching from GR00T cannot leak hidden hue augmentation into ACT", () => {
+  const request = configToRequest({
+    ...baseConfig, policy_type: "act", dataset_image_transforms_enable: true,
+    dataset_task: "color_sorting_v1",
+  });
+  expect(request.dataset_image_transforms_enable).toBe(false);
+  expect(request.dataset_task).toBe("color_sorting_v1");
+  expect(policyChunkValidationIssue({
+    ...baseConfig, dataset_task: "color_sorting_v1", policy_type: "groot",
+  })).toContain("requires ACT");
+});
+
+test("ACT chunk validation rejects invalid ranges before submission", () => {
+  expect(policyChunkValidationIssue({
+    ...baseConfig,
+    policy_chunk_size: 8,
+    policy_n_action_steps: 9,
+  })).toContain("cannot exceed");
+  expect(policyChunkValidationIssue({
+    ...baseConfig,
+    policy_chunk_size: 1.5,
+    policy_n_action_steps: 1,
+  })).toContain("positive integer");
+  expect(policyChunkValidationIssue({
+    ...baseConfig,
+    policy_type: "diffusion",
+    policy_chunk_size: 1,
+    policy_n_action_steps: 2,
+  })).toBeNull();
+});
+
+test("policy-specific request fields do not leak into unrelated policies", () => {
+  const request = configToRequest({
+    ...baseConfig,
+    policy_type: "diffusion",
+    policy_chunk_size: 32,
+    policy_n_action_steps: 8,
+    policy_base_model_path: "nvidia/GR00T-N1.7-3B",
+  });
+
+  expect(request.policy_chunk_size).toBeUndefined();
+  expect(request.policy_n_action_steps).toBeUndefined();
+  expect(request.policy_base_model_path).toBeUndefined();
+});
diff --git a/frontend/src/components/training/toTrainingRequest.ts b/frontend/src/components/training/toTrainingRequest.ts
new file mode 100644
index 0000000000000000000000000000000000000000..50cbb26dfc3db4f513d37395fd3479b9a0b14b94
