diff --git a/frontend/src/components/dataset/ChartCompatibility.test.tsx b/frontend/src/components/dataset/ChartCompatibility.test.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..09cd563c1c28215cb2fdff749a9963ee5bd81ab2
--- /dev/null
+++ b/frontend/src/components/dataset/ChartCompatibility.test.tsx
@@ -0,0 +1,139 @@
+// @vitest-environment jsdom
+// Real Recharts rendering; only API responses and jsdom layout are synthetic.
+import React, { act } from "react";
+import { createRoot, Root } from "react-dom/client";
+import { afterEach, beforeEach, expect, test, vi } from "vitest";
+import MotionTrace from "./MotionTrace";
+import MonitoringStats from "../training/monitoring/MonitoringStats";
+import MetricsPanel from "../control/MetricsPanel";
+import { getMotion } from "@/lib/datasetApi";
+import { getJobMetricsHistory } from "@/lib/jobsApi";
+import type { TrainingStatus } from "../training/types";
+
+const api = vi.hoisted(() => ({ baseUrl: "http://localhost:8000", fetchWithHeaders: vi.fn() }));
+vi.mock("@/contexts/ApiContext", () => ({ useApi: () => api }));
+vi.mock("@/lib/datasetApi", () => ({ getMotion: vi.fn() }));
+vi.mock("@/lib/jobsApi", () => ({ getJobMetricsHistory: vi.fn() }));
+
+let host: HTMLDivElement;
+let root: Root;
+beforeEach(() => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  const rect = { x: 0, y: 0, left: 0, top: 0, right: 640, bottom: 240, width: 640, height: 240, toJSON() {} };
+  vi.spyOn(HTMLElement.prototype, "getBoundingClientRect").mockReturnValue(rect);
+  vi.spyOn(SVGElement.prototype, "getBoundingClientRect").mockReturnValue({ ...rect, x: 4, left: 4, right: 636, width: 632 });
+  vi.spyOn(HTMLElement.prototype, "offsetWidth", "get").mockReturnValue(640);
+  vi.spyOn(HTMLElement.prototype, "offsetHeight", "get").mockReturnValue(240);
+  vi.stubGlobal("ResizeObserver", class {
+    constructor(private callback: ResizeObserverCallback) {}
+    observe(target: Element) {
+      this.callback([{ target, contentRect: rect } as ResizeObserverEntry], this as unknown as ResizeObserver);
+    }
+    unobserve() {}
+    disconnect() {}
+  });
+  vi.stubGlobal("fetch", vi.fn(() => { throw new Error("No network or hardware in chart fixtures"); }));
+  host = document.createElement("div");
+  document.body.append(host);
+  root = createRoot(host);
+});
+afterEach(() => {
+  act(() => root.unmount());
+  host.remove();
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+});
+
+async function pointer(element: Element, type: string, x: number, y = 100) {
+  await act(async () => {
+    element.dispatchEvent(new MouseEvent(type, { bubbles: true, clientX: x, clientY: y }));
+    await new Promise((resolve) => setTimeout(resolve, 30));
+  });
+}
+
+test("motion chart renders values, formats tooltip and seeks first/middle/last dataset frames", async () => {
+  vi.mocked(getMotion).mockResolvedValue({ success: true, episode_index: 6, motion: [0, 2, 4, 1, 3], max_motion: 4 });
+  const seek = vi.fn();
+  await act(async () => root.render(<MotionTrace repoId="fixture/charts" episodeIndex={6} currentFrame={2} onSeekFrame={seek} />));
+  expect(host.querySelector(".recharts-area-curve")?.getAttribute("d")).toContain("M");
+  expect(host.querySelector(".recharts-reference-line-line")).not.toBeNull();
+  const chart = host.querySelector(".recharts-wrapper")!;
+  const seekArea = host.querySelector(".motion-seek-area")!;
+  // SVG layers are portals in v3: the hit surface must be above the area, not
+  // merely later in JSX. Direct dispatch alone cannot detect this regression.
+  const paintedArea = host.querySelector(".recharts-area-area")!;
+  expect(paintedArea.compareDocumentPosition(seekArea) & Node.DOCUMENT_POSITION_FOLLOWING).toBeTruthy();
+  // Click without an earlier hover must use the clicked point, not cached tooltip state.
+  await pointer(seekArea, "click", 320);
+  expect(seek).toHaveBeenLastCalledWith(2);
+  seek.mockClear();
+  for (const [x, frame] of [[4, 0], [320, 2], [636, 4]]) {
+    await pointer(chart, "mousemove", x);
+    expect(host.querySelector(".recharts-tooltip-wrapper")?.textContent).toContain(`Frame ${frame}`);
+    await pointer(seekArea, "click", x);
+    expect(seek).toHaveBeenLastCalledWith(frame);
+  }
+  expect(host.querySelector(".recharts-tooltip-wrapper")?.textContent).toContain("3.00");
+  await pointer(seekArea, "click", -10);
+  expect(seek).toHaveBeenCalledTimes(3);
+  await pointer(seekArea, "click", 4);
+  expect(seek).toHaveBeenLastCalledWith(0); // old hover still points at frame 4
+});
+
+test("motion failure stays unavailable and cannot seek", async () => {
+  vi.mocked(getMotion).mockResolvedValue({ success: false, episode_index: 0, motion: [], max_motion: 0, message: "missing action" });
+  await act(async () => root.render(<MotionTrace repoId="fixture/charts" episodeIndex={0} currentFrame={0} onSeekFrame={vi.fn()} />));
+  expect(host.textContent).toContain("Joint motion unavailable");
+  expect(host.querySelector(".recharts-wrapper")).toBeNull();
+});
+
+test("changing episode removes the old seek surface while the new action stream loads", async () => {
+  vi.mocked(getMotion).mockResolvedValueOnce({ success: true, episode_index: 0, motion: [0, 1], max_motion: 1 });
+  const seek = vi.fn();
+  await act(async () => root.render(<MotionTrace repoId="fixture/charts" episodeIndex={0} currentFrame={1} onSeekFrame={seek} />));
+  expect(host.querySelector(".motion-seek-area")).not.toBeNull();
+  let resolveMotion!: (value: Awaited<ReturnType<typeof getMotion>>) => void;
+  vi.mocked(getMotion).mockReturnValueOnce(new Promise((resolve) => { resolveMotion = resolve; }));
+  await act(async () => root.render(<MotionTrace repoId="fixture/charts" episodeIndex={1} currentFrame={0} onSeekFrame={seek} />));
+  expect(host.querySelector(".motion-seek-area")).toBeNull();
+  await act(async () => resolveMotion({ success: true, episode_index: 1, motion: [0], max_motion: 0 }));
+  await pointer(host.querySelector(".motion-seek-area")!, "click", 320);
+  expect(seek).toHaveBeenCalledExactlyOnceWith(0);
+});
+
+test("training loss and learning-rate charts load saved points, format tooltips and append a live tick", async () => {
+  vi.mocked(getJobMetricsHistory).mockResolvedValue([
+    { step: 1, loss: 0.75, lr: 0.0001, grad_norm: null },
+    { step: 2, loss: 0.5, lr: 0.00005, grad_norm: null },
+  ]);
+  const status: TrainingStatus = {
+    training_active: false, current_step: 2, total_steps: 3, current_loss: 0.5, current_lr: 0.00005,
+    available_controls: { stop_training: false, pause_training: false, resume_training: false },
+  };
+  const render = (trainingStatus: TrainingStatus) => root.render(<MonitoringStats jobId="fixture" trainingStatus={trainingStatus} getProgressPercentage={() => 66.7} formatTime={String} />);
+  await act(async () => render(status));
+  const charts = host.querySelectorAll(".recharts-wrapper");
+  expect(charts).toHaveLength(2);
+  expect(host.querySelectorAll(".recharts-line-curve")).toHaveLength(2);
+  await pointer(charts[0], "mousemove", 628);
+  expect(charts[0].textContent).toContain("0.5000");
+  await pointer(charts[1], "mousemove", 628);
+  expect(charts[1].textContent).toContain("5.00e-5");
+  const before = host.querySelector(".recharts-line-curve")!.getAttribute("d");
+  await act(async () => render({ ...status, current_step: 3, current_loss: 0.25, current_lr: 0.00001 }));
+  expect(host.querySelector(".recharts-line-curve")!.getAttribute("d")).not.toBe(before);
+  expect(host.textContent).toContain("3 / 3");
+});
+
+test("legacy motor and sensor charts still render without camera permission", async () => {
+  const samples = [0, 1, 2].map((i) => Object.fromEntries(
+    ["motor1", "motor2", "motor3", "motor4", "motor5", "motor6", "sensor3", "sensor4"].map((key) => [key, i]),
+  ));
+  const props = { setActiveTab: vi.fn(), sensorData: samples, motorData: samples, hasPermissions: false, streamRef: { current: null }, isVoiceActive: false, micLevel: 0 };
+  await act(async () => root.render(<MetricsPanel {...props} activeTab="MOTORS" />));
+  expect(host.querySelectorAll(".recharts-wrapper")).toHaveLength(6);
+  await act(async () => root.render(<MetricsPanel {...props} activeTab="SENSORS" />));
+  expect(host.querySelectorAll(".recharts-wrapper")).toHaveLength(2);
+  expect(host.textContent).toContain("Camera permission not granted");
+  expect(host.querySelector("video")).toBeNull();
+});
