+def _validate_windows_checkpoint_path_budget(job_dir: Path) -> None:
+    """Fail before training when native checkpoint writers will exceed MAX_PATH."""
+    if os.name != "nt":
+        return
+    representative = (
+        job_dir
+        / "run"
+        / "checkpoints"
+        / "000000"
+        / "pretrained_model"
+        / "policy_preprocessor_step_99_normalizer_processor.safetensors"
+    )
