diff --git a/lelab/mode.py b/lelab/mode.py
new file mode 100644
index 0000000..8589503
--- /dev/null
+++ b/lelab/mode.py
@@ -0,0 +1,42 @@
+"""Process-local ownership gate for hardware-affecting LeLab modes."""
+
+from __future__ import annotations
+
+import threading
+from typing import Literal
+
+HardwareMode = Literal["calibration", "teleoperation", "recording", "inference"]
+
+
+class HardwareModeGate:
+    """Atomically reserve the single local hardware owner slot."""
+
+    def __init__(self) -> None:
+        self._lock = threading.Lock()
+        self._owner: HardwareMode | None = None
+
+    def claim(self, mode: HardwareMode) -> tuple[bool, HardwareMode | None]:
+        with self._lock:
+            if self._owner is not None:
+                return False, self._owner
+            self._owner = mode
+            return True, None
+
+    def release(self, mode: HardwareMode) -> bool:
+        with self._lock:
+            if self._owner != mode:
+                return False
+            self._owner = None
+            return True
+
+    def current(self) -> HardwareMode | None:
+        with self._lock:
+            return self._owner
+
+    def reset_for_test(self) -> None:
+        """Reset only for a no-device test fixture."""
+        with self._lock:
+            self._owner = None
+
+
+hardware_mode_gate = HardwareModeGate()
