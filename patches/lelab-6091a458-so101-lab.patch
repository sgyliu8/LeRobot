+    # extended-path prefix. Leave headroom for longer processor step names.
+    if len(str(representative.resolve())) >= 240:
+        raise ValueError(
+            "Local training output path is too long for reliable Windows checkpoint saves; "
+            "choose a shorter LELAB_OUTPUT_ROOT"
+        )
+
+
+def _validate_windows_checkpoint_read_paths(checkpoint_dir: Path) -> None:
+    """Reject source files whose native readers may not honor extended paths."""
+    if os.name != "nt":
+        return
+    too_long = [path for path in checkpoint_dir.rglob("*") if path.is_file() and len(str(path)) >= 240]
+    if too_long:
+        raise ValueError(
+            "Source checkpoint path is too long for reliable Windows loading; "
+            "move or copy the job to a shorter local output root before resuming"
+        )
