+          gripper: 5,
+        }}
+        setMaxRelativeTarget={() => {}}
+        cameras={[]}
+        setCameras={() => {}}
+        onStart={() => {}}
+      />,
+    ));
+    const preset = Array.from(host.querySelectorAll("button")).find(
+      (button) => button.textContent?.includes("Use color sorting v1"),
+    );
+    expect(preset).toBeDefined();
+    act(() => preset?.dispatchEvent(new MouseEvent("click", { bubbles: true })));
+    expect(setDatasetName).toHaveBeenCalledWith("color_sorting_v1");
+    expect(setSingleTask).toHaveBeenCalledWith(
+      "Sort the visible cube into the bin with the same color.",
