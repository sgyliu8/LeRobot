+}));
+vi.mock("@/components/recording/CameraConfiguration", () => ({ default: () => null }));
+vi.mock("@/components/ui/dialog", () => ({
+  Dialog: ({ open, children }: { open: boolean; children: React.ReactNode }) => open ? children : null,
+  DialogContent: ({ children }: { children: React.ReactNode }) => children,
+  DialogHeader: ({ children }: { children: React.ReactNode }) => children,
+  DialogTitle: ({ children }: { children: React.ReactNode }) => children,
+  DialogDescription: ({ children }: { children: React.ReactNode }) => children,
+}));
+vi.mock("@/components/ui/collapsible", () => ({
+  Collapsible: ({ children }: { children: React.ReactNode }) => children,
+  CollapsibleContent: ({ children }: { children: React.ReactNode }) => children,
+  CollapsibleTrigger: ({ children }: { children: React.ReactNode }) => children,
+}));
+
+test("color sorting preset fills only the bounded recording fields", () => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  const setDatasetName = vi.fn();
+  const setSingleTask = vi.fn();
+  const setNumEpisodes = vi.fn();
+  const setDatasetFps = vi.fn();
+  try {
+    act(() => root.render(
+      <RecordingModal
+        open
+        onOpenChange={() => {}}
+        robot={null}
+        datasetName=""
+        setDatasetName={setDatasetName}
+        singleTask=""
+        setSingleTask={setSingleTask}
+        numEpisodes={1}
+        setNumEpisodes={setNumEpisodes}
+        episodeTimeS={30}
+        setEpisodeTimeS={() => {}}
+        resetTimeS={10}
+        setResetTimeS={() => {}}
+        datasetFps={10}
+        setDatasetFps={setDatasetFps}
+        streamingEncoding
+        setStreamingEncoding={() => {}}
+        encoderCrf={23}
+        setEncoderCrf={() => {}}
+        maxRelativeTarget={{
+          shoulder_pan: 5,
+          shoulder_lift: 5,
+          elbow_flex: 5,
+          wrist_flex: 5,
+          wrist_roll: 5,
+          gripper: 5,
+        }}
+        setMaxRelativeTarget={() => {}}
+        cameras={[]}
+        setCameras={() => {}}
+        onStart={() => {}}
+      />,
+    ));
+    const preset = Array.from(host.querySelectorAll("button")).find(
+      (button) => button.textContent?.includes("Use color sorting v1"),
+    );
+    expect(preset).toBeDefined();
+    act(() => preset?.dispatchEvent(new MouseEvent("click", { bubbles: true })));
+    expect(setDatasetName).toHaveBeenCalledWith("color_sorting_v1");
+    expect(setSingleTask).toHaveBeenCalledWith(
+      "Sort the visible cube into the bin with the same color.",
+    );
+    expect(setNumEpisodes).toHaveBeenCalledWith(3);
+    expect(setDatasetFps).toHaveBeenCalledWith(15);
+  } finally {
+    act(() => root.unmount());
+  }
+});
