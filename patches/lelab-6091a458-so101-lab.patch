+                "-Target $env:LELAB_TEST_TARGET | Out-Null"
+            ),
+        ],
+        check=False,
+        capture_output=True,
+        text=True,
+        env=environment,
+    )
+    if result.returncode != 0:
+        pytest.skip(f"directory link unavailable: {result.stderr}")
