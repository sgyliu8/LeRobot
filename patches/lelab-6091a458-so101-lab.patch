+type VideoWithFrameCallback = HTMLVideoElement & {
+  requestVideoFrameCallback?: (
+    callback: (now: number, metadata: { mediaTime: number }) => void,
+  ) => number;
+  cancelVideoFrameCallback?: (handle: number) => void;
+};
+
+interface WindowedSecondaryVideoProps {
+  identity: string;
+  src: string;
+  poster: string;
+  fromTs: number;
+  toTs: number;
+  onRef: (element: HTMLVideoElement | null) => void;
+}
+
+const WindowedSecondaryVideo: React.FC<WindowedSecondaryVideoProps> = ({
+  identity,
+  src,
+  poster,
+  fromTs,
+  toTs,
+  onRef,
+}) => {
+  const videoRef = useRef<VideoWithFrameCallback | null>(null);
+  const setVideoRef = (element: HTMLVideoElement | null) => {
+    videoRef.current = element;
+    onRef(element);
+  };
+
+  useEffect(() => {
+    const video = videoRef.current;
+    if (!video?.requestVideoFrameCallback) return;
+    let handle = 0;
+    const guard = (_now: number, metadata: { mediaTime: number }) => {
+      if (metadata.mediaTime < fromTs || metadata.mediaTime >= toTs) {
+        video.currentTime = fromTs;
+      }
+      handle = video.requestVideoFrameCallback!(guard);
+    };
+    handle = video.requestVideoFrameCallback(guard);
+    return () => video.cancelVideoFrameCallback?.(handle);
+  }, [identity, fromTs, toTs]);
+
+  const clampToWindow = (video: HTMLVideoElement) => {
+    if (video.currentTime < fromTs || video.currentTime >= toTs) {
+      video.currentTime = fromTs;
+    }
+  };
+
+  return (
+    <video
+      ref={setVideoRef}
+      src={src}
+      poster={poster}
+      className="max-h-[22vh] w-auto max-w-full bg-black object-contain"
+      preload="auto"
+      playsInline
+      muted
+      onLoadedMetadata={(event) => {
+        event.currentTarget.currentTime = fromTs;
+      }}
+      onTimeUpdate={(event) => clampToWindow(event.currentTarget)}
+      onEnded={(event) => clampToWindow(event.currentTarget)}
+    />
+  );
+};
