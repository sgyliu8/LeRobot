+def _control_context(session_id: str) -> tuple[dict[str, Any] | None, dict[str, Any] | None]:
+    # The lease, active flag and event object form one identity snapshot. Reading
+    # them separately permits an ABA interleaving where an old token is checked
+    # against an old lease but the returned event object belongs to a new run.
+    with _state_lock:
+        lease = _recording_lease
+        active = recording_active
+        events = recording_events
+        if not active or events is None:
+            return None, {"success": False, "status_code": 409, "message": "No recording session is active"}
+        if lease is None or session_id != lease.token:
+            return None, {"success": False, "status_code": 409, "message": "Stale recording session"}
+        return events, None
+
+
+def _validate_phase_control(events: dict[str, Any], phase_id: int, expected: set[str]) -> dict[str, Any] | None:
+    if not events["_phase_open"] or events["_phase_id"] != phase_id:
+        return {"success": False, "status_code": 409, "message": "Stale recording phase"}
+    if events["_phase_name"] not in expected:
+        return {
+            "success": False,
+            "status_code": 409,
+            "message": f"Control is not valid during {events['_phase_name']}",
+        }
+    return None
 
 
