+// @vitest-environment jsdom
+import React, { act } from "react";
+import { createRoot } from "react-dom/client";
+import { expect, test } from "vitest";
+import { RecordingStartReceipt, StartReceipt } from "./Recording";
+
+test("shows backend-effective profile and exact resume arithmetic", () => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  const receipt: StartReceipt = {
+    dataset_id: "local/demo_20260918_120000",
+    session_id: "fixture-session",
+    existing_episodes: 1,
+    additional_episodes: 2,
+    final_expected_episodes: 3,
+    effective_config: {
+      dataset_fps: 15,
+      cameras: {
+        arm: { camera_index: 1, width: 640, height: 480, fps: 30, backend: "DSHOW" },
+        table_veiw: { camera_index: 2, width: 640, height: 480, fps: 30, backend: "DSHOW" },
+      },
+      rgb_encoder: {
+        vcodec: "h264",
+        pix_fmt: "yuv420p",
+        video_backend: "pyav",
+        crf: 23,
+        g: 2,
+      },
+      max_relative_target: {
+        shoulder_pan: 5,
+        shoulder_lift: 5,
+        elbow_flex: 5,
+        wrist_flex: 5,
+        wrist_roll: 5,
+        gripper: 5,
+      },
+      max_relative_target_units: {
+        shoulder_pan: "degree",
+        shoulder_lift: "degree",
+        elbow_flex: "degree",
+        wrist_flex: "degree",
+        wrist_roll: "degree",
+        gripper: "normalized_0_100",
+      },
+    },
+  };
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    act(() => root.render(<RecordingStartReceipt receipt={receipt} />));
+    expect(host.textContent).toContain("1 existing + 2 additional = 3 expected");
+    expect(host.textContent).toContain("Dataset 15 Hz");
+    expect(host.textContent).toContain("arm: index 1 · 640×480 @ 30 Hz · backend DSHOW");
+    expect(host.textContent).toContain("table_veiw: index 2 · 640×480 @ 30 Hz · backend DSHOW");
+    expect(host.textContent).toContain("h264/yuv420p/pyav");
+    expect(host.textContent).toContain("shoulder_pan=5 degree");
+    expect(host.textContent).toContain("gripper=5 normalized_0_100");
+  } finally {
+    act(() => root.unmount());
+  }
+});
