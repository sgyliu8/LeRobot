+def recording_profile_issues(
+    repo_id: str,
+    profile: dict[str, Any] | None,
+    dataset: dict[str, Any],
+) -> list[str]:
+    """Return reasons a frozen local profile cannot safely authorize resume."""
+
+    if not isinstance(profile, dict):
+        return ["frozen recording profile is missing or unreadable"]
+
+    issues: list[str] = []
+    keys = set(profile)
+    missing = sorted(RECORDING_PROFILE_KEYS - keys)
+    extra = sorted(keys - RECORDING_PROFILE_KEYS)
+    if missing or extra:
+        issues.append(f"recording profile fields differ from schema: missing={missing}, extra={extra}")
+    if profile.get("schema_version") != RECORDING_PROFILE_SCHEMA_VERSION:
+        issues.append(
+            f"recording profile schema must be {RECORDING_PROFILE_SCHEMA_VERSION}"
+        )
+
+    try:
+        canonical = _canonicalize_repo_id(repo_id)
+    except ValueError as exc:
+        issues.append(f"dataset identity is invalid: {exc}")
+        canonical = repo_id
+    if profile.get("dataset_repo_id") != canonical:
+        issues.append("recording profile dataset identity does not match")
+
+    task = profile.get("single_task")
+    if not isinstance(task, str) or not task.strip():
+        issues.append("recording profile single_task is missing or empty")
+    else:
+        for episode in dataset.get("episodes") or []:
+            tasks = episode.get("tasks") if isinstance(episode, dict) else None
+            if not isinstance(tasks, list) or len(tasks) != 1 or tasks[0] != task:
+                issues.append("recording profile single_task does not match every indexed episode")
+                break
+
+    dataset_fps = profile.get("dataset_fps")
+    if isinstance(dataset_fps, bool) or not isinstance(dataset_fps, int) or dataset_fps <= 0:
+        issues.append("recording profile dataset_fps must be a positive integer")
+    elif dataset_fps != dataset.get("fps"):
+        issues.append("recording profile FPS does not match Dataset metadata")
+    if profile.get("video") is not True:
+        issues.append("recording profile must preserve video=True")
+    if profile.get("push_to_hub") is not False:
+        issues.append("recording profile must preserve push_to_hub=False")
+    if not isinstance(profile.get("streaming_encoding"), bool):
+        issues.append("recording profile streaming_encoding must be boolean")
+
+    encoder = profile.get("rgb_encoder")
+    try:
+        validated_encoder = RGBEncoderRequest.model_validate(encoder)
+        if validated_encoder.model_dump() != encoder:
+            issues.append("recording profile RGB encoder is not canonical")
+    except (ValidationError, TypeError):
+        issues.append("recording profile RGB encoder is invalid")
+
+    limits = profile.get("max_relative_target")
+    if not isinstance(limits, dict) or set(limits) != set(SO101_LIMIT_UNITS):
+        issues.append("recording profile target limits must use exactly the six SO-101 joint keys")
+    elif any(
+        isinstance(value, bool)
+        or not isinstance(value, (int, float))
+        or not math.isfinite(float(value))
+        or float(value) <= 0
+        for value in limits.values()
+    ):
+        issues.append("recording profile target limits must be finite and greater than zero")
+    if profile.get("max_relative_target_units") != SO101_LIMIT_UNITS:
+        issues.append("recording profile target-limit units are invalid")
+
+    cameras = profile.get("cameras")
+    if not isinstance(cameras, dict) or set(cameras) != M5_CAMERA_ROLES:
+        issues.append("recording profile must contain exactly arm and table_veiw cameras")
+    else:
+        camera_indices: list[str] = []
+        for role, value in cameras.items():
+            try:
+                validated_camera = CameraRequest.model_validate(value)
+                if validated_camera.model_dump() != value:
+                    issues.append(f"recording profile camera {role} is not canonical")
+                camera_indices.append(str(validated_camera.camera_index))
+            except (ValidationError, TypeError):
+                issues.append(f"recording profile camera {role} is invalid")
+        if len(camera_indices) == len(cameras) and len(set(camera_indices)) != len(camera_indices):
+            issues.append("recording profile cameras must use different indices")
+    profile_camera_keys = sorted(cameras.keys()) if isinstance(cameras, dict) else []
+    if profile_camera_keys != sorted(dataset.get("cameras") or []):
+        issues.append("recording profile camera keys do not match Dataset metadata")
+
+    robot = profile.get("robot")
+    robot_keys = {"leader_port", "follower_port", "leader_config", "follower_config"}
+    if (
+        not isinstance(robot, dict)
+        or set(robot) != robot_keys
+        or any(not isinstance(robot.get(key), str) or not robot[key].strip() for key in robot_keys)
+    ):
+        issues.append("recording profile robot identity is incomplete")
+    if profile.get("action_semantics") != "processed_operator_target":
+        issues.append("recording profile action semantics are invalid")
+    if profile.get("timestamp_semantics") != "nominal_frame_index_div_dataset_fps":
+        issues.append("recording profile timestamp semantics are invalid")
+    return issues
+
+
+def read_recording_profile(repo_id: str) -> dict[str, Any] | None:
+    """Read the ignored local profile used to authorize an exact resume."""
+
+    canonical = _canonicalize_repo_id(repo_id)
+    path = _profile_path(canonical)
+    if not path.is_file():
+        return None
+    try:
+        payload = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError):
+        return None
+    if not isinstance(payload, dict) or payload.get("dataset_repo_id") != canonical:
+        return None
+    return payload
+
+
+def _persist_profile(request: RecordingRequest) -> None:
+    path = _profile_path(request.dataset_repo_id)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    payload = json.dumps(_profile_payload(request), indent=2, sort_keys=True)
+    temporary = path.with_suffix(".tmp")
+    temporary.write_text(payload, encoding="utf-8")
+    temporary.replace(path)
+
+
+def _validate_resume_profile(request: RecordingRequest) -> None:
+    path = _profile_path(request.dataset_repo_id)
+    if not path.is_file():
+        raise ValueError(
+            "Cannot resume safely: the local recording profile is missing. "
+            "Browse the dataset read-only; do not guess its limits, labels, cameras, or encoder settings."
+        )
+    try:
+        existing = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, json.JSONDecodeError) as exc:
+        raise ValueError(f"Cannot resume safely: unreadable recording profile: {exc}") from exc
+    requested = _profile_payload(request)
+    if existing != requested:
+        changed = sorted(key for key in requested if existing.get(key) != requested.get(key))
+        raise ValueError(f"Cannot resume with a changed recording profile: {changed}")
+
+
+def _effective_config(request: RecordingRequest) -> dict[str, Any]:
+    payload = _profile_payload(request)
+    payload.update(
+        {
+            "resume": request.resume,
+            "additional_episodes": int(request.num_episodes),
+            "push_to_hub": False,
+            "video": request.video,
+        }
+    )
+    return payload
+
