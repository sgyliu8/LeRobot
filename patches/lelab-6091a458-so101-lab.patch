+      attempts_started: 4,
+      preflight_rejected: 1,
+      placements_started: 2,
+      correct_placements: 1,
+      human_outcomes: { success: 1, failure: 1, abort: 1, unknown: 1 },
+    },
+  };
+  const text = renderToStaticMarkup(<ColorSortingSummary selected summary={summary} />);
