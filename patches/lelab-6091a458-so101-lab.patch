@@ -0,0 +1,31 @@
+// @vitest-environment jsdom
+import { act, lazy, Suspense } from "react";
+import { createRoot } from "react-dom/client";
+import { MemoryRouter } from "react-router-dom";
+import { afterEach, expect, test, vi } from "vitest";
+import PageBoundary from "./PageBoundary";
+
+Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+afterEach(() => vi.restoreAllMocks());
+
+test("failed lazy import preserves surrounding controls and never retries the page", async () => {
+  // React reports the deliberately rejected synthetic import to the console.
+  vi.spyOn(console, "error").mockImplementation(() => {});
+  const load = vi.fn().mockRejectedValue(new Error("synthetic missing chunk"));
+  const Page = lazy(load);
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    await act(async () => root.render(
+      <MemoryRouter>
+        <button>Existing global stop notice</button>
+        <PageBoundary><Suspense fallback="Loading"><Page /></Suspense></PageBoundary>
+      </MemoryRouter>,
+    ));
+    expect(host.querySelector('[role="alert"]')?.textContent).toContain("No automatic reload or task retry");
+    expect(host.querySelector("button")?.textContent).toBe("Existing global stop notice");
+    expect(load).toHaveBeenCalledTimes(1);
+  } finally {
+    await act(async () => root.unmount());
+  }
+});
diff --git a/frontend/src/components/PageBoundary.tsx b/frontend/src/components/PageBoundary.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..25d5564fd459ed2e5bb1194ba16aea55f27292fa
--- /dev/null
+++ b/frontend/src/components/PageBoundary.tsx
@@ -0,0 +1,32 @@
+import { Component, type ReactNode } from "react";
+import { useLocation } from "react-router-dom";
+
+class PageErrorBoundary extends Component<{ children: ReactNode }, { failed: boolean }> {
+  state = { failed: false };
+
+  static getDerivedStateFromError() {
+    return { failed: true };
+  }
+
+  componentDidCatch(error: Error) {
+    console.error("Page loading failed:", error);
+  }
+
+  render() {
+    if (this.state.failed) {
+      return (
+        <div role="alert" className="p-6 space-y-2">
+          <h1 className="font-semibold">Page could not be loaded</h1>
+          <p>No automatic reload or task retry was attempted. If a robot task is active,
+            stop it normally or use your independent stop before refreshing this page.</p>
+        </div>
+      );
+    }
+    return this.props.children;
+  }
+}
+
+export default function PageBoundary({ children }: { children: ReactNode }) {
+  const { pathname } = useLocation();
+  return <PageErrorBoundary key={pathname}>{children}</PageErrorBoundary>;
+}
