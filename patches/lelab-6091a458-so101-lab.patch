- * directly and never sets the flag, so this never double-fires.
+ * Reconcile an unload-time stop request. A keepalive request is not proof that
+ * cleanup completed, so this checks the worker's cached exact-session state
+ * and only then reports a clean disconnect.
  */
 const TeleopStopNotice = () => {
   const { toast } = useToast();
+  const { baseUrl, fetchWithHeaders } = useApi();
 
   useEffect(() => {
