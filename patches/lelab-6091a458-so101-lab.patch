+vi.mock("./HubModelCard", () => ({ default: () => null }));
+vi.mock("./ImportModelModal", () => ({ default: () => null }));
+vi.mock("@/components/landing/InferenceModal", () => ({ default: () => null }));
+
+test.each(["pending", "rejected"])("local checkpoints render while Hub is %s", async (state) => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  mocks.listJobs.mockResolvedValue([{ id: "fixture", name: "Local checkpoint fixture", runner: "local", state: "done", checkpoint_count: 1 }]);
+  mocks.listHubJobs.mockImplementation(() => state === "pending"
+    ? new Promise(() => {}) : Promise.reject(new Error("fixture offline")));
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    await act(async () => { root.render(<JobsSection />); });
+    expect(host.textContent).toContain("Local checkpoint fixture");
+    expect(host.textContent).not.toContain("Couldn't load jobs");
+  } finally {
+    act(() => root.unmount());
+  }
+});
