+}
+
+
+def _scope_header(scope: Scope, name: bytes) -> str | None:
+    for key, value in scope.get("headers", []):
+        if key.lower() == name:
+            return value.decode("latin-1")
+    return None
+
+
+def _trusted_host(raw_host: str | None) -> bool:
+    if not raw_host:
+        return False
+    try:
+        parsed = urlsplit(f"//{raw_host}")
+        return parsed.hostname in _TRUSTED_HOSTNAMES and parsed.port in (None, 8000)
+    except ValueError:
+        return False
+
+
+class LocalRequestBoundaryMiddleware:
+    """Reject DNS-rebinding hosts and cross-site browser requests before routing."""
+
+    def __init__(self, app):
+        self.app = app
+
+    async def __call__(self, scope: Scope, receive, send):
+        if scope["type"] not in {"http", "websocket"}:
+            await self.app(scope, receive, send)
+            return
+
+        host = _scope_header(scope, b"host")
+        origin = _scope_header(scope, b"origin")
+        status_code = 400 if not _trusted_host(host) else 403 if origin not in (None, *_TRUSTED_ORIGINS) else None
+        if status_code is None:
+            await self.app(scope, receive, send)
+            return
+
+        if scope["type"] == "websocket":
+            await send({"type": "websocket.close", "code": 1008})
+            return
+        response = JSONResponse({"detail": "Untrusted local request boundary"}, status_code=status_code)
+        await response(scope, receive, send)
+
