+    status: "FROZEN", episodes: 7, sessions: 3, pending: 0, excluded: 1,
+  }} />);
+  expect(html).toContain("Review and split frozen");
+  expect(html).toContain("rechecked at training start");
+  expect(html).toContain("does not mean task success");
+  expect(html).toContain("1");
+  expect(html).toContain("data_preparation_cli");
+  expect(html).not.toContain("<button"); // No motion, repair, deletion or training action.
+});
