+// @vitest-environment jsdom
+import { act } from "react";
+import { createRoot } from "react-dom/client";
+import { MemoryRouter } from "react-router-dom";
+import { expect, test, vi } from "vitest";
+import { OnboardingProvider } from "./OnboardingProvider";
+import { useOnboarding } from "./OnboardingContext";
+
+vi.mock("@/hooks/useOnboardingProgress", () => ({ useOnboardingProgress: () => ({
+  hasSelectedRobot: false, robotIsClean: false, hasLocalDataset: false,
+  hasTrainedModel: false, isAuthenticated: false,
+}) }));
+vi.mock("@/components/onboarding/SpotlightOverlay", () => ({ default: () => null }));
+vi.mock("@/components/onboarding/TourLauncher", () => ({ default: () => null }));
+vi.mock("@/components/onboarding/WelcomeDialog", () => ({
+  default: ({ open }: { open: boolean }) => open ? <p>Welcome fixture</p> : null,
+}));
+
+test("starting a tour closes welcome and shares progress through the extracted context", async () => {
+  Object.assign(globalThis, { IS_REACT_ACT_ENVIRONMENT: true });
+  localStorage.clear();
+  let tour: ReturnType<typeof useOnboarding>;
+  function Probe() {
+    tour = useOnboarding();
+    return <output>{tour.stepIndex}</output>;
+  }
+  const host = document.createElement("div");
+  const root = createRoot(host);
+  try {
+    await act(async () => root.render(<MemoryRouter><OnboardingProvider><Probe /></OnboardingProvider></MemoryRouter>));
+    expect(host.textContent).toContain("Welcome fixture");
+    await act(async () => tour.start());
+    expect(host.textContent).not.toContain("Welcome fixture");
+    expect(tour!.isActive).toBe(true);
+    await act(async () => tour.next());
+    expect(tour!.stepIndex).toBe(1);
+    expect(host.textContent).not.toContain("Welcome fixture");
+    await act(async () => tour.stop(false));
+    expect(tour!.isActive).toBe(false);
+    expect(host.textContent).not.toContain("Welcome fixture");
+  } finally {
+    await act(async () => root.unmount());
+    localStorage.clear();
+  }
+});
