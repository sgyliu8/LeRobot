+        events = recording_events
+        if not active or events is None:
+            return None, {"success": False, "status_code": 409, "message": "No recording session is active"}
+        if lease is None or session_id != lease.token:
+            return None, {"success": False, "status_code": 409, "message": "Stale recording session"}
+        return events, None
+
