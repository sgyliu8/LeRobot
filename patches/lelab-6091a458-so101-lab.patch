+    expect(COLOR_SORTING_PRESET.datasetName).toBe("color_sorting_v1");
+    expect(COLOR_SORTING_PRESET.datasetFps).toBe(15);
+    expect(COLOR_SORTING_PRESET.cameraAliases).toEqual({ arm: "wrist", table_veiw: "front" });
+  });
+
+  it("states the effective ACT candidate without pretending task text is conditioning", () => {
+    expect(COLOR_SORTING_PRESET.policy).toEqual({ type: "act", chunkSize: 32, nActionSteps: 8 });
