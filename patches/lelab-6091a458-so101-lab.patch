@@ -0,0 +1,190 @@
+# Copyright 2025 The HuggingFace Inc. team. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+
+"""Durable local wrapper around the pinned LeRobot training entry point."""
+
+from __future__ import annotations
+
+import argparse
+import contextlib
+import io
+import json
+import os
+import sys
+import threading
+import time
+import traceback
+from pathlib import Path
+
+
+class _JsonLineWriter(io.TextIOBase):
+    def __init__(self, path: Path) -> None:
+        self._path = path
+        self._path.parent.mkdir(parents=True, exist_ok=True)
+        self._stream = path.open("a", encoding="utf-8", buffering=1)
+        self._buffer = ""
+        self._lock = threading.Lock()
+
+    @property
+    def encoding(self) -> str:
+        return "utf-8"
+
+    def writable(self) -> bool:
+        return True
+
+    def write(self, text: str) -> int:
+        if not isinstance(text, str):
+            text = str(text)
+        with self._lock:
+            self._buffer += text
+            while "\n" in self._buffer:
+                line, self._buffer = self._buffer.split("\n", 1)
+                self._emit(line.rstrip("\r"))
+        return len(text)
+
+    def flush(self) -> None:
+        with self._lock:
+            if self._buffer:
+                self._emit(self._buffer.rstrip("\r"))
+                self._buffer = ""
+            self._stream.flush()
+
+    def close(self) -> None:
+        if not self.closed:
+            self.flush()
+            super().close()
+            self._stream.close()
+
+    def _emit(self, message: str) -> None:
+        if message:
+            self._stream.write(
+                json.dumps(
+                    {"timestamp": time.time(), "message": message},
+                    ensure_ascii=False,
+                    separators=(",", ":"),
+                )
+                + "\n"
+            )
+
+
+def _write_receipt(path: Path, payload: dict[str, object]) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    temporary = path.with_suffix(path.suffix + ".tmp")
+    temporary.write_text(json.dumps(payload, indent=2), encoding="utf-8")
+    os.replace(temporary, path)
+
+
+def _remove_existing_alias(path: Path) -> None:
+    if path.is_symlink():
+        path.unlink()
+        return
+    is_junction = getattr(os.path, "isjunction", lambda _path: False)
+    if is_junction(path):
+        path.rmdir()
+        return
+    if path.exists():
+        raise FileExistsError(f"Refusing to replace non-link checkpoint alias: {path}")
+
+
+def update_last_checkpoint_portable(checkpoint_dir: Path) -> Path:
+    """Update ``checkpoints/last`` without requiring Windows symlink rights."""
+    checkpoint_dir = checkpoint_dir.resolve(strict=True)
+    last_checkpoint_dir = checkpoint_dir.parent / "last"
+    _remove_existing_alias(last_checkpoint_dir)
+    relative_target = checkpoint_dir.relative_to(checkpoint_dir.parent)
+    try:
+        last_checkpoint_dir.symlink_to(relative_target, target_is_directory=True)
+    except OSError as exc:
+        if os.name != "nt" or getattr(exc, "winerror", None) != 1314:
+            raise
+        import _winapi
+
+        _winapi.CreateJunction(str(checkpoint_dir), str(last_checkpoint_dir))
+        print("[LeLab] checkpoints/last uses a Windows directory junction.")
+    return last_checkpoint_dir
+
+
+def _parse_args() -> tuple[Path, Path, str, list[str]]:
+    parser = argparse.ArgumentParser(add_help=False)
+    parser.add_argument("--lelab-log-file", required=True)
+    parser.add_argument("--lelab-terminal-receipt", required=True)
+    parser.add_argument("--lelab-job-token", required=True)
+    parser.add_argument("trainer_args", nargs=argparse.REMAINDER)
+    parsed = parser.parse_args()
+    trainer_args = list(parsed.trainer_args)
+    if trainer_args and trainer_args[0] == "--":
+        trainer_args.pop(0)
+    return (
+        Path(parsed.lelab_log_file),
+        Path(parsed.lelab_terminal_receipt),
+        parsed.lelab_job_token,
+        trainer_args,
+    )
+
+
+def main() -> int:
+    log_path, receipt_path, job_token, trainer_args = _parse_args()
+    started_at = time.time()
+    _write_receipt(
+        receipt_path,
+        {
+            "schema_version": 1,
+            "job_token": job_token,
+            "state": "running",
+            "pid": os.getpid(),
+            "started_at": started_at,
+            "ended_at": None,
+            "exit_code": None,
+        },
+    )
+
+    writer = _JsonLineWriter(log_path)
+    exit_code = 1
+    error: str | None = None
+    with contextlib.redirect_stdout(writer), contextlib.redirect_stderr(writer):
+        try:
+            from lerobot.common import train_utils
+
+            train_utils.update_last_checkpoint = update_last_checkpoint_portable
+            split_path = log_path.parent / "training_split.json"
+            if split_path.is_file():
+                from so101_lab.training_split import install_dataset_factory, parse_manifest
+
+                manifest = parse_manifest(split_path.read_text(encoding="utf-8"))
+                install_dataset_factory(manifest, log_path.parent / "training_data_receipt.json")
+            from lerobot.scripts import lerobot_train
+
+            sys.argv = ["lerobot-train", *trainer_args]
+            lerobot_train.main()
+            exit_code = 0
+        except SystemExit as exc:
+            exit_code = int(exc.code or 0) if isinstance(exc.code, (int, type(None))) else 1
+            if exit_code:
+                error = f"Trainer exited with code {exit_code}"
+        except BaseException as exc:  # keep the original traceback in the durable log
+            error = f"{type(exc).__name__}: {exc}"
+            traceback.print_exc()
+            exit_code = 1
+        finally:
+            writer.flush()
+    writer.close()
+    _write_receipt(
+        receipt_path,
+        {
+            "schema_version": 1,
+            "job_token": job_token,
+            "state": "terminal",
+            "pid": os.getpid(),
+            "started_at": started_at,
+            "ended_at": time.time(),
+            "exit_code": exit_code,
+            "error": error,
+        },
+    )
+    return exit_code
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
